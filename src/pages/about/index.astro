---
import Base from '../../layouts/Base.astro';
import PushPhoto from '../../components/PushPhoto.astro';
import ForVenues from '../../components/ForVenues.astro';
import site from '../../data/site.json';
import { bioHtml } from '../../lib/site.js';
import { PATREON, PATREON_LINE, PHOTO_CREDITS as C } from '../../components/content.js';
---
<Base image="about" title="About | GLucak" current="about" description="GLucak: Horsham producer-rapper and DJ. Energetic, faith-based EDM, rap and rock.">
  <section class="band band-push" aria-labelledby="h-push">
    <div class="push-head">
      <PushPhoto />
      <div class="wrap push-title">
        <h1 class="spine" id="h-push"><span class="tab">About</span> <span class="phrase fit lock-push"><span class="ln ln-push1">Push Past</span> <span class="ln ln-push2">Fear</span></span></h1>
      </div>
    </div>
    <div class="wrap push-body about-body">
      <div class="bio">
        <p class="epi"><span class="epi-head">Epilepsy survivor</span> <span class="epi-sub">Healed by Christ since 2009</span></p>
        <Fragment set:html={bioHtml(site)} />
      </div>
      <div class="push-actions about-actions">
        <ul class="about-set">
          <li><a href="/music/">Listen</a></li>
          <li><a href="/shows/">Shows</a></li>
          <li><a href={PATREON} rel="noopener">Patreon</a></li>
        </ul>
        <p class="patreon-line">{PATREON_LINE}</p>
        <a class="btn btn-line about-patreon" href={PATREON} rel="noopener">Patreon</a>
      </div>
      <section class="gallery" aria-labelledby="h-photos">
        <h2 class="prose-h" id="h-photos">Photos</h2>
        <ul class="gallery-grid">
          <li><a href="/media/cd-studio-960.webp"><img class="graded" src="/media/cd-studio-480.webp" srcset="/media/cd-studio-480.webp 480w, /media/cd-studio-960.webp 960w" sizes="(min-width: 900px) 18vw, (min-width: 34rem) 17rem, 47vw" width="960" height="960" alt="GLucak in his home studio, headphones on, his gear on the floor around him" loading="lazy" /></a></li>
          <li><a href="/media/photo-mccc-478.webp"><img class="graded" src="/media/photo-mccc-478.webp" width="478" height="477" alt="GLucak on stage, one arm out, a drum kit behind him" loading="lazy" /></a></li>
          <li><a href="/media/photo-crooked-eye-634.webp"><img class="graded" src="/media/photo-crooked-eye-634.webp" width="634" height="1128" alt="GLucak pointing up as he sings at Crooked Eye Brewery" loading="lazy" /></a></li>
        </ul>
      </section>
    </div>
    <div class="wrap prose">
      <ForVenues />
      <h2>Credits</h2>
      <ul class="credit-list">
        {Object.values(C).map((c) => <li>{c.replace(/\.$/, '')}</li>)}
        <li>Guest on You’re Not Alone: Emily Mae</li>
      </ul>
    </div>
  </section>
</Base>
