---
import Base from '../../layouts/Base.astro';
import PushPhoto from '../../components/PushPhoto.astro';
import ForVenues from '../../components/ForVenues.astro';
import HScroll from '../../components/HScroll.astro';
import site from '../../data/site.json';
import { bioHtml } from '../../lib/site.js';
import { PATREON, PATREON_LINE, PHOTO_CREDITS as C } from '../../components/content.js';
// Owner 2026-11-18: the Photos grid became a scrapbook that slides past (HScroll). Real photos only; each one's credit is in CREDIT_FOR (content.js).
// Stills: frames from his music videos (tools/film: the same downloads), 1280 + 480 webp in /media/stills.
const ALBUM = [
  { src: '/media/cd-studio-960.webp', thumb: '/media/cd-studio-480.webp', srcset: '/media/cd-studio-480.webp 480w, /media/cd-studio-960.webp 960w', w: 960, h: 960, alt: 'GLucak in his home studio, headphones on, his gear on the floor around him', cap: 'In the home studio' },
  { src: '/media/photo-crooked-eye-634.webp', w: 634, h: 1128, alt: 'GLucak pointing up as he sings at Crooked Eye Brewery', cap: 'Scenic Route, live at Crooked Eye Brewery' },
  { src: '/media/stills/yna-floor-1280.webp', thumb: '/media/stills/yna-floor-480.webp', srcset: '/media/stills/yna-floor-480.webp 480w, /media/stills/yna-floor-1280.webp 1280w', w: 1280, h: 720, alt: 'GLucak sitting on the floor writing, pages scattered around him', cap: 'You’re Not Alone: writing it down' },
  { src: '/media/stills/rl-room-1280.webp', thumb: '/media/stills/rl-room-480.webp', srcset: '/media/stills/rl-room-480.webp 480w, /media/stills/rl-room-1280.webp 1280w', w: 1280, h: 720, alt: 'GLucak standing in a white room lit by a strip of lights', cap: 'Rapping Like (Oh Yeah)' },
  { src: '/media/photo-mccc-478.webp', w: 478, h: 477, alt: 'GLucak on stage, one arm out, a drum kit behind him', cap: 'On stage at Montgomery County Community College' },
  { src: '/media/stills/ddjf-garage-1280.webp', thumb: '/media/stills/ddjf-garage-480.webp', srcset: '/media/stills/ddjf-garage-480.webp 480w, /media/stills/ddjf-garage-1280.webp 1280w', w: 1280, h: 720, alt: 'GLucak dancing in a garage beside a car on a jack', cap: 'Duck, Dodge, Jump, Fight!' },
  { src: '/media/stills/yna-mic-1280.webp', thumb: '/media/stills/yna-mic-480.webp', srcset: '/media/stills/yna-mic-480.webp 480w, /media/stills/yna-mic-1280.webp 1280w', w: 1280, h: 720, alt: 'GLucak singing into a mic on a stand against a white wall', cap: 'You’re Not Alone, at the mic' },
  { src: '/media/stills/eys-arm-1280.webp', thumb: '/media/stills/eys-arm-480.webp', srcset: '/media/stills/eys-arm-480.webp 480w, /media/stills/eys-arm-1280.webp 1280w', w: 1280, h: 720, alt: 'GLucak on stage with one arm up, a drum kit and amps behind him', cap: 'Earned Your Stripes, arm up' },
];
---
<Base image="about" title="About | GLucak" current="about" description="GLucak: Horsham producer-rapper and DJ. Energetic, faith-based EDM, rap and rock.">
  <section class="band band-push" aria-labelledby="h-push">
    <div class="push-head">
      <PushPhoto />
      <div class="wrap push-title">
        <h1 class="spine" id="h-push"><span class="tab">About</span> <span class="phrase fit lock-push"><span class="ln ln-push1">Push Past</span> <span class="ln ln-push2">Fear</span></span></h1>
      </div>
    </div>
    <div class="wrap push-body about-body">
      <div class="bio">
        <p class="epi"><span class="epi-head">Epilepsy survivor</span> <span class="epi-sub">Healed by Christ since 2009</span></p>
        <Fragment set:html={bioHtml(site)} />
      </div>
      <div class="push-actions about-actions">
        <ul class="about-set">
          <li><a href="/music/">Listen</a></li>
          <li><a href="/shows/">Shows</a></li>
          <li><a href={PATREON} rel="noopener">Patreon</a></li>
        </ul>
        <p class="patreon-line">{PATREON_LINE}</p>
        <a class="btn btn-line about-patreon" href={PATREON} rel="noopener">Patreon</a>
      </div>
    </div>
    <HScroll id="album" kind="photo" title="Photo album" sub="Shows, shoots and the home studio." items={ALBUM} />
    <div class="wrap prose is-paper">
      <ForVenues sheet={false} />
      <h2>Credits</h2>
      <ul class="credit-list">
        {Object.values(C).map((c) => <li>{c.replace(/\.$/, '')}</li>)}
        <li>Guest on You’re Not Alone: Emily Mae</li>
      </ul>
    </div>
  </section>
</Base>
