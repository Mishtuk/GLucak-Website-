---
import Base from '../../layouts/Base.astro';
import PushPhoto from '../../components/PushPhoto.astro';
import ForVenues from '../../components/ForVenues.astro';
import site from '../../data/site.json';
import { bioHtml } from '../../lib/site.js';
import { PATREON, PATREON_LINE, PHOTO_CREDITS as C, SOCIALS } from '../../components/content.js';
const ORDER = ['spotify', 'youtube', 'instagram', 'soundcloud', 'threads', 'x', 'patreon'];
const links = ORDER.map((id) => SOCIALS.find((s) => s.id === id));
---
<Base image="about" title="About | GLucak" current="about" credits={[C.kealey, C.cd]} description="GLucak: Horsham producer-rapper and DJ. Energetic, faith-based EDM, rap and rock.">
  <section class="band band-push" aria-labelledby="h-push">
    <div class="push-head">
      <PushPhoto eager />
      <div class="wrap push-title">
        <h1 class="spine" id="h-push"><span class="tab">About</span> <span class="phrase fit lock-push"><span class="ln ln-push1">Push Past</span> <span class="ln ln-push2">Fear</span></span></h1>
      </div>
    </div>
    <div class="wrap push-body about-body">
      <div class="bio">
        <p class="epi"><span class="epi-head">Epilepsy survivor</span> <span class="epi-sub">Healed by Christ since 2009</span></p>
        <Fragment set:html={bioHtml(site)} />
      </div>
      <div class="push-actions about-actions">
        <ul class="about-set">
          <li><a href="/music/">Listen</a></li>
          <li><a href="/shows/">Shows</a></li>
          <li><a href={PATREON} rel="noopener">Patreon</a></li>
        </ul>
        <p class="patreon-line">{PATREON_LINE}</p>
        <a class="btn btn-line about-patreon" href={PATREON} rel="noopener">Patreon</a>
        <img class="about-photo" src="/media/cd-studio-480.webp" srcset="/media/cd-studio-480.webp 480w, /media/cd-studio-960.webp 960w" sizes="(min-width: 900px) 38vw, (min-width: 34rem) 30rem, 100vw" width="960" height="960" alt="GLucak in his home studio, headphones on, his gear on the floor around him" loading="lazy" />
      </div>
    </div>
    <div class="wrap prose">
      <ForVenues />
      <h2>Find GLucak</h2>
      <ul class="links links-lg">
        {links.map((s) => <li class={s.id === 'patreon' ? 'links-wide' : undefined}><a href={s.href} rel="noopener"><svg aria-hidden="true"><use href={`#i-${s.id}`} /></svg><span>{s.name}</span></a></li>)}
      </ul>
      <h2>Credits</h2>
      <ul class="credit-list">
        {[C.kealey, C.joseph, C.yt, C.vladd, C.cd, C.identity].map((c) => <li>{c.replace(/\.$/, '')}</li>)}
      </ul>
    </div>
  </section>
</Base>
