---
import Base from '../../layouts/Base.astro';
import { PATREON, SOCIALS } from '../../components/content.js';
---
<Base title="About | GLucak" current="about" description="GLucak: Epilepsy survivor, Producer-Rapper/DJ, making energetic music with faith.">
  <section class="band band-push" aria-labelledby="h-push">
    <div class="push-head">
      <picture>
        <source type="image/webp" srcset="/media/live-1200.webp 1200w, /media/live-2400.webp 2400w" sizes="100vw" />
        <img class="duo push-photo" src="/media/live-1200.jpg" alt="" width="2400" height="1600" fetchpriority="high" />
      </picture>
      <div class="wrap push-title">
        <h1 class="spine" id="h-push"><span class="tab">About</span> <span class="phrase fit lock-push"><span class="ln ln-push1">Push Past</span> <span class="ln ln-push2">Fear</span></span></h1>
      </div>
    </div>
    <div class="wrap push-body">
      <div class="bio">
        <p class="bio-lead">Despite facing various difficulties and struggles over the years, Epilepsy survivor and Producer-Rapper/DJ GLucak has shown no intent to give up on either his Faith in God or his mission in creating energetic music to bring others to Christ.</p>
        <p>Two albums and numerous singles and EPs into the biz and with no plans to slow down, GLucak has been running at a ferocious pace crafting brand-new content and music for 2026 and 2027. Nevertheless, no matter the musical style or genre, be it his debut single or his upcoming 3rd album (rumored to be his best work yet), the mission statement has always been the same: Rise, Live It Loud, Push Past Fear, The Time Is Now.</p>
        <p class="photo-credit">Photo: Alexander Kealey.</p>
      </div>
      <div class="push-actions">
        <a class="btn btn-solid" href={PATREON} rel="noopener">Patreon</a>
      </div>
    </div>
    <div class="wrap prose">
      <h2>Follow GLucak</h2>
      <ul class="socials">
        {SOCIALS.map(([name, href]) => <li><a href={href} rel="noopener">{name}</a></li>)}
      </ul>
      <p class="muted">Booking email: coming soon. <span class="ph-chip inline">Placeholder</span></p>
    </div>
  </section>
</Base>
