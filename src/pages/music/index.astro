---
import Base from '../../layouts/Base.astro';
import RiseBand from '../../components/RiseBand.astro';
import { crate, era, SOUNDCLOUD, identity, dateLine, credit, TYPE_TAG } from '../../components/content.js';
const idn = identity();
const tiles = crate(); // all releases but IDENTITY (its own block below), newest first
const shortDate = (d) => new Date(`${d}T12:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base image="music" title="Music | GLucak" current="music" description="Listen to GLucak: the playlist, every release, and IDENTITY.">
  <RiseBand h1 release={false} />
  <section class="band releases-band" id="releases" aria-labelledby="h-releases">
    <div class="wrap">
      <h2 id="h-releases" class="prose-h">All releases</h2>
      {tiles.length > 0 && (
        <ul class="crate">
          {tiles.map((r) => (
            <li class="tile" data-state={r.coming ? 'coming' : undefined}>
              <a class="tile-link" href={r.link} rel="noopener">
                {r.cover
                  ? <img class="tile-art" src={r.cover} alt="" width="300" height="300" loading="lazy" />
                  : <span class="tile-art tile-art-none" aria-hidden="true">{r.coming && <span class="tile-when">{shortDate(r.date)}</span>}</span>}
                <span class="tile-text">
                  <h3 class="tile-title">{r.title}</h3>
                  {credit(r) && <span class="tile-artists">{credit(r)}</span>}
                  <span class="tile-meta">{TYPE_TAG[r.type] && r.type !== 'single' && <span class="tile-tag">{TYPE_TAG[r.type]}</span>}{r.coming ? `Out ${dateLine(r.date)}` : dateLine(r.date)}</span>
                  <span class="tile-go">{r.coming ? 'Pre-save' : 'Listen'}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {idn.date ? (
          <div class="identity-state">
            {era.mark && <img class="mark mark-identity" src={era.mark} alt="" width="300" height="96" loading="lazy" />}<p class="identity identity-lg">IDENTITY</p>
            {idn.out
              ? <p class="identity-when">Out now. <a class="text-link" href={idn.link} rel="noopener" aria-label="Listen to IDENTITY">Listen</a></p>
              : <><p class="identity-when"><time datetime={idn.date}>{idn.pretty}</time> &middot; {idn.days} {idn.days === 1 ? 'day' : 'days'} to go</p>
                 <a class="btn btn-line" href={idn.link} rel="noopener">Pre-save IDENTITY</a></>}
          </div>
        ) : <div class="identity-state">{era.mark && <img class="mark mark-identity" src={era.mark} alt="" width="300" height="96" loading="lazy" />}<p class="identity identity-lg">IDENTITY</p></div>}
      <p class="under-player"><a class="text-link" href={SOUNDCLOUD} rel="noopener">Hear more on SoundCloud</a></p>
    </div>
  </section>
</Base>
