---
import Base from '../../layouts/Base.astro';
import RiseBand from '../../components/RiseBand.astro';
import { releases, era, SOUNDCLOUD, identity } from '../../components/content.js';
const idn = identity();
const all = releases();
---
<Base title="Music | GLucak" current="music" description="Listen to GLucak: the playlist, every release, and IDENTITY.">
  <RiseBand />
  <section class="band" aria-labelledby="h-releases">
    <div class="wrap">
      <h2 id="h-releases" class="prose-h">Releases</h2>
      <ul class="releases">
        {all.map((r) => (
          <li class="release">
            <img class="cover" src={r.cover} alt={r.placeholder ? `Placeholder for the ${r.title} cover art` : `${r.title} cover art`} width="400" height="400" loading="lazy" />
            <div class="release-text">
              <h3>{r.title}</h3>
              <p class="listen-on">
                <a href={r.link} rel="noopener">every platform</a>
                {r.soundcloud && <a href={r.soundcloud} rel="noopener">SoundCloud</a>}
              </p>
              {r.placeholder && <p class="ph-chip inline">Placeholder cover</p>}
            </div>
          </li>
        ))}
      </ul>
      {idn.date ? (
          <div class="identity-state">
            <p class="identity identity-lg">IDENTITY</p>
            {idn.out
              ? <p class="identity-when">Out now. <a class="text-link" href={idn.link} rel="noopener">Listen</a></p>
              : <><p class="identity-when"><time datetime={idn.date}>{idn.pretty}</time> &middot; {idn.days} {idn.days === 1 ? 'day' : 'days'} to go</p>
                 <a class="btn btn-line" href={idn.link} rel="noopener">Pre-save IDENTITY</a></>}
          </div>
        ) : <p class="identity identity-lg">IDENTITY</p>}
      <p class="muted">Era word: {era.word} <span class="ph-chip inline">Placeholder</span></p>
      <p class="under-player"><a href={SOUNDCLOUD} rel="noopener">More on SoundCloud</a></p>
    </div>
  </section>
</Base>
