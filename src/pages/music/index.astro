---
import Base from '../../layouts/Base.astro';
import RiseBand from '../../components/RiseBand.astro';
import { releases, upcoming, era, SOUNDCLOUD, identity, dateLine, credit, TYPE_TAG } from '../../components/content.js';
const idn = identity();
const all = releases();
const soon = upcoming().filter((r) => r.title !== 'IDENTITY'); // IDENTITY has its own block below
---
<Base image="music" title="Music | GLucak" current="music" description="Listen to GLucak: the playlist, every release, and IDENTITY.">
  <RiseBand />
  <section class="band" aria-labelledby="h-releases">
    <div class="wrap">
      <h2 id="h-releases" class="prose-h">All releases</h2>
      {soon.length > 0 && (
        <ul class="releases coming">
          {soon.map((r) => (
            <li class="release-row">
              <p class="release-meta">{TYPE_TAG[r.type] ?? ''} &middot; Out {dateLine(r.date)}</p>
              <h3>{r.title}</h3>
              {credit(r) && <p class="credit">{credit(r)}</p>}
              <p class="listen-on"><a href={r.link} rel="noopener">Pre-save</a></p>
            </li>
          ))}
        </ul>
      )}
      <ul class="releases">
        {all.map((r) => (
          <li class="release">
            <img class="cover" src={r.cover} alt={r.placeholder ? `Placeholder for the ${r.title} cover art` : `${r.title} cover art`} width="400" height="400" loading="lazy" />
            <div class="release-text">
              {(TYPE_TAG[r.type] || r.date) && <p class="release-meta">{[TYPE_TAG[r.type], dateLine(r.date)].filter(Boolean).join(' · ')}</p>}
              <h3>{r.title}</h3>
              {credit(r) && <p class="credit">{credit(r)}</p>}
              <p class="listen-on">
                <a href={r.link} rel="noopener">Listen</a>
                {r.soundcloud && <a href={r.soundcloud} rel="noopener">SoundCloud</a>}
              </p>
              {r.placeholder && <p class="ph-chip inline">Placeholder cover</p>}
            </div>
          </li>
        ))}
      </ul>
      {idn.date ? (
          <div class="identity-state">
            {era.mark && <img class="mark mark-identity" src={era.mark} alt="" width="300" height="96" loading="lazy" />}<p class="identity identity-lg">IDENTITY</p>
            {idn.out
              ? <p class="identity-when">Out now. <a class="text-link" href={idn.link} rel="noopener">Listen</a></p>
              : <><p class="identity-when"><time datetime={idn.date}>{idn.pretty}</time> &middot; {idn.days} {idn.days === 1 ? 'day' : 'days'} to go</p>
                 <a class="btn btn-line" href={idn.link} rel="noopener">Pre-save IDENTITY</a></>}
          </div>
        ) : <div class="identity-state">{era.mark && <img class="mark mark-identity" src={era.mark} alt="" width="300" height="96" loading="lazy" />}<p class="identity identity-lg">IDENTITY</p></div>}
      <p class="under-player"><a href={SOUNDCLOUD} rel="noopener">Hear more on SoundCloud</a></p>
    </div>
  </section>
</Base>
