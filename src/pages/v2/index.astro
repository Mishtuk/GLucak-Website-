---
// /v2/: the variant Home for the side-by-side (docs/review/v2-compare/README.md). Unlinked, noindex, not in the sitemap.
// Applies modern-references.md top 5: release card, video row, a different photo per slot, phrase beside content from 900px,
// solid header band. Reuses the real components and data; only the layout and its stylesheet are new.
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Signup from '../../components/Signup.astro';
import { PATREON, PHOTO_CREDITS as C, SPOTIFY_EMBED, SPOTIFY_PLAYLIST, credit, dateLine, era, identity, latestVideo, releases } from '../../components/content.js';
import videos from '../../data/videos.json';
import '../../styles/v2.css';

const idn = identity();
const r = releases()[0];
const latest = latestVideo();
const featured = videos.filter((v) => v.featured && /^[\w-]{11}$/.test(v.id ?? '') && v.id !== latest?.id)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? '')).slice(0, 2);
const row = [latest, ...featured].filter(Boolean).map((v) => ({ ...v, href: `https://www.youtube.com/watch?v=${v.id}`, thumb: `/media/videos/${v.id}` }));
const credits = [C.kealey, C.joseph];
---
<Base title="GLucak (v2 preview)" home hero="ab" credits={credits}>
  <meta name="robots" content="noindex" slot="head" />
  <div class="top">
    <div class="glow" aria-hidden="true"></div>
    <Hero variant="ab" />

    <section class="band band-rise" id="music" aria-labelledby="h-rise">
      <div class="wrap v2-split">
        <div class="v2-side">
          <h2 class="spine" id="h-rise"><span class="tab">Music</span> <span class="phrase phrase-rise">Rise</span></h2>
          <img class="v2-photo v2-wide-only v2-land" src="/media/v2/garage-480.webp" srcset="/media/v2/garage-480.webp 480w, /media/v2/garage-874.webp 874w" sizes="40vw" width="874" height="492" alt="GLucak in a tire shop garage, from the Duck, Dodge, Jump, Fight video" loading="lazy" />
        </div>
        <div class="v2-card">
          <article class="v2-rel">
            <img class="v2-cover" src={r.cover} alt={r.placeholder ? `Placeholder for the ${r.title} cover art` : `${r.title} cover art`} width="400" height="400" />
            <div class="v2-rel-text">
              <p class="v2-kicker">Latest {r.type ?? 'release'}{r.date && <> &middot; {dateLine(r.date)}</>}</p>
              <h3>{r.title}</h3>
              {credit(r) && <p class="credit">{credit(r)}</p>}
              <a class="btn btn-solid" href={r.link} rel="noopener" aria-label={`Listen to ${r.title}`}>Listen</a>
            </div>
          </article>
          <a class="skip skip-inline" href="#after-player">Skip the Spotify player</a>
          <div class="player-box">
            <p class="player-note">Loading the Spotify player. If it doesn't appear, use <strong>Play full songs on Spotify</strong> below.</p>
            <iframe class="player" title="GLucak playlist on Spotify" src={SPOTIFY_EMBED} width="100%" height="352" loading="lazy" allow="encrypted-media; clipboard-write; fullscreen"></iframe>
          </div>
          <p class="under-player" id="after-player">
            <a class="btn btn-line btn-small" href={SPOTIFY_PLAYLIST} rel="noopener">Play full songs on Spotify</a>
            {r.soundcloud && <a class="under-link" href={r.soundcloud} rel="noopener">SoundCloud</a>}
          </p>
        </div>
      </div>
    </section>
  </div>

  <section class="band band-live" id="shows" aria-labelledby="h-live">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine fade" id="h-live"><span class="tab">Shows</span> <span class="phrase fit"><span class="ln ln-live">Live It Loud</span></span></h2>
        <img class="v2-photo v2-wide-only v2-tall" src="/media/v2/stage-360.webp" srcset="/media/v2/stage-360.webp 360w, /media/v2/stage-634.webp 634w" sizes="40vw" width="634" height="1128" alt="GLucak singing on stage at Crooked Eye Brewery" loading="lazy" />
      </div>
      <div class="v2-main">
        <div id="shows-mount"><Fragment set:html="<!--gl:shows-->" /></div>
        <a class="text-link" href="/shows/">All shows</a>
        <div class="v2-videos" id="shows-video">
          <h3>Watch</h3>
          <ul class="v2-vrow">
            {row.map((v, i) => (
              <li class:list={['v2-vid', { 'v2-vid-big': i === 0 }]}>
                <a href={v.href} rel="noopener">
                  <span class="v2-thumb">
                    <img src={`${v.thumb}-640.webp`} srcset={`${v.thumb}-640.webp 640w, ${v.thumb}-1280.webp 1280w`} sizes={i === 0 ? '(min-width: 900px) 40vw, 82vw' : '(min-width: 900px) 20vw, 82vw'} width="1280" height="720" alt="" loading="lazy" decoding="async" />
                    <span class="yt-play" aria-hidden="true"></span>
                  </span>
                  <span class="v2-vtitle">{i === 0 && <span class="v2-tag">Latest</span>} {v.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-push v2-push" id="about" aria-labelledby="h-push">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine fade" id="h-push"><span class="tab">About</span> <span class="phrase fit"><span class="ln ln-push1">Push Past</span> <span class="ln ln-push2">Fear</span></span></h2>
      </div>
      <div class="v2-main v2-push-body">
        <img class="v2-photo v2-belt" src="/media/v2/belt-320.webp" srcset="/media/v2/belt-320.webp 320w, /media/v2/belt-634.webp 634w" sizes="(min-width: 900px) 20vw, 30vw" width="634" height="1128" alt="GLucak live at Crooked Eye Brewery, arm raised" loading="lazy" />
        <div class="v2-slot v2-wide-only" role="img" aria-label="Empty photo slot: crowd shot, waiting on Gabe's OK"><span>Photo slot: crowd shot. Waiting on Gabe's OK.</span></div>
        <p class="bio-lead v2-bio">Despite facing various difficulties and struggles over the years, Epilepsy survivor and Producer-Rapper/DJ GLucak has shown no intent to give up on either his Faith in God or his mission in creating energetic music to bring others to Christ.</p>
        <div class="push-actions">
          <a class="btn btn-solid" href={PATREON} rel="noopener">Patreon</a>
          <a class="btn btn-line" href="/about/">About GLucak</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-now" id="join" aria-labelledby="h-now">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine fade" id="h-now"><span class="tab">Join</span> <span class="phrase fit"><span class="ln ln-now1">The Time</span> <span class="ln ln-now2">Is Now</span></span></h2>
      </div>
      <div class="v2-main now-grid">
        <Signup />
        <div class="v2-identity">
          <img class="v2-photo" src="/media/v2/identity-art-240.webp" srcset="/media/v2/identity-art-240.webp 240w, /media/v2/identity-art-480.webp 480w" sizes="(min-width: 900px) 12rem, 26vw" width="480" height="597" alt="IDENTITY artwork: GLucak in blue light" loading="lazy" />
          <div class="identity-state">
            {era.mark && <img class="mark mark-identity" src={era.mark} alt="" width="300" height="96" loading="lazy" />}
            <p class="identity">IDENTITY</p>
            {idn.date && (idn.out
              ? <p class="identity-when">Out now. <a class="text-link" href={idn.link} rel="noopener" aria-label="Listen to IDENTITY">Listen</a></p>
              : <><p class="identity-when"><time datetime={idn.date}>{idn.pretty}</time> &middot; {idn.days} {idn.days === 1 ? 'day' : 'days'} to go</p>
                 <a class="btn btn-line" href={idn.link} rel="noopener">Pre-save IDENTITY</a></>)}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
