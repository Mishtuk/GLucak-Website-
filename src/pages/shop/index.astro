---
// The temporary store (D36). server.js fills the gl:shop marker per visit from the live products file (like shows):
// grid, detail sections (/shop/#product-<id>), the sample banner, and the Preview chip + noindex until SHOP_ENABLED=1.
// Checkout is the provider's page (Fourthwall per the research); this site never handles card data.
import Base from '../../layouts/Base.astro';
---
<Base image="shop" title="Shop | GLucak" description="GLucak merch and music.">
  <section class="band band-shop" aria-labelledby="h-shop">
    <div class="wrap">
      <h1 class="spine shop-title" id="h-shop"><span class="tab">Shop</span> <span class="phrase fit"><span class="ln ln-merch">Merch</span></span></h1>
      <div id="shop-mount"><Fragment set:html="<!--gl:shop-->" /></div>
    </div>
  </section>
</Base>
