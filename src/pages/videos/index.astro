---
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import HScroll from '../../components/HScroll.astro';
import { videosPage, YOUTUBE, SHORTS, PHOTO_CREDITS as C } from '../../components/content.js';
import { curly } from '../../lib/shows.js';
// Owner 2026-11-18: a theatre. "Now showing" (the newest music video) on a big screen with its name in poster type, then every other
// video on a film strip that slides past as you scroll (HScroll). No iframe until a press (hard rule 1).
const g = videosPage();
const live = g.lead ? [g.lead, ...g.live] : g.live;
const lead = g.music[0] ?? live[0] ?? null;
const rest = [...g.music, ...live].filter((v) => v !== lead);
const thumb = lead && existsSync(`public/media/videos/${lead.id}-1280.webp`) && existsSync(`public/media/videos/${lead.id}-640.webp`) ? `/media/videos/${lead.id}` : null;
const leadMeta = lead && [lead.place ? `Live at ${lead.place}` : lead.kind === 'lyric-video' ? 'Lyric video' : 'Music video', lead.with].filter(Boolean).join(' · ');
---
<Base image="videos" title="Videos | GLucak" current="videos" credits={[C.vladd, C.joseph, C.yt]} description="Watch GLucak: every music video, and Scenic Route live at Crooked Eye.">
  <section class="band band-vids" aria-labelledby="h-vids">
    <div class="wrap vids">
      <h1 class="spine" id="h-vids"><span class="tab">Videos</span> <span class="phrase phrase-watch">Watch</span></h1>
      {lead ? (
        <div class="v2-vid now-showing">
          <p class="now-label">Now showing</p>
          <a href={`https://www.youtube.com/watch?v=${lead.id}`} rel="noopener" data-yt={lead.id} data-title={curly(lead.name ?? lead.title)}>
            <span class="v2-thumb">{thumb && <img class="yt-img" src={`${thumb}-640.webp`} srcset={`${thumb}-640.webp 640w, ${thumb}-1280.webp 1280w`} sizes="(min-width: 1200px) 1100px, 92vw" width="1280" height="720" alt="" loading="eager" fetchpriority="high" decoding="async" />}<span class="yt-play" aria-hidden="true"></span></span>
            <span class="v2-vtitle">{curly(lead.name ?? lead.title)}</span>
          </a>
          <p class="vid-meta"><span>{leadMeta}</span></p>
        </div>
      ) : <p class="vid-lead"><a class="go" href={YOUTUBE} rel="noopener">GLucak on YouTube</a></p>}
    </div>
  </section>
  {rest.length > 0 && <HScroll id="reel" kind="video" title="The reel" sub="Every music video and live clip." items={rest} tail={{ href: SHORTS, text: 'New shorts most weeks on YouTube.' }} />}
  {rest.length === 0 && <p class="wrap start-line vid-more"><a class="go" href={SHORTS} rel="noopener">New shorts most weeks on YouTube.</a></p>}
</Base>
