---
// Gabe's edit screen (Shows | Releases | IDENTITY | Bio | Products | Videos tabs). A static shell: public/js/edit.js signs in and builds the lists from
// /edit/api/shows, /edit/api/releases, /edit/api/products and /edit/api/videos with createElement + textContent/value only. Not linked from the site; noindex.
import '../../styles/global.css';
import { era } from '../../components/content.js';

const HEX = /^#[0-9a-f]{6}$/i;
const lum = (h) => { const c = [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4)); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
const scheme = HEX.test(era.colors.bg) && lum(era.colors.bg) > 0.4 ? 'light' : 'dark';
const eraCss = Object.entries(era.colors).filter(([, v]) => HEX.test(v)).map(([k, v]) => `--${k}:${v}`).join(';');
---
<!doctype html>
<html lang="en" data-admin data-scheme={scheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit the site | GLucak</title>
    <link rel="icon" href="data:," />
    <style set:html={`html:root{${eraCss}}`}></style>
    <script is:inline src="/js/edit.js" defer></script>
  </head>
  <body class="ed-body">
    <main class="ed">
      <h1 class="ed-title"><span class="ed-site">GLucak</span> <span class="ed-title-t">Edit the site</span></h1>
      <noscript><p>This page needs JavaScript. Turn it on, then reload.</p></noscript>

      <form id="login" class="ed-card" method="post" action="/edit/login">
        <h2>Sign in</h2>
        <label for="username">Name</label>
        <input id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="64" />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="200" />
        <button class="ed-btn ed-main" type="submit">Sign in</button>
        <p id="login-msg" class="ed-msg" role="status"></p>
      </form>

      <section id="editor" hidden>
        <div class="ed-side">
        <div class="ed-who"><span id="who"></span>
          <span class="ed-who-btns"><a class="ed-btn ed-plain" href="/" target="_blank" rel="noopener">View site</a>
          <button id="logout" class="ed-btn ed-plain" type="button">Sign out</button></span></div>
        <div id="out-ask" class="ed-ask" role="alert" hidden><p id="out-q">Not saved yet. Sign out anyway?</p>
          <p class="ed-ask-btns"><button id="out-yes" class="ed-btn" type="button">Sign out</button> <button id="out-no" class="ed-btn" type="button">Stay</button></p></div>
        <div class="ed-tabs" role="tablist" aria-label="What to edit">
          <button id="tab-shows" class="ed-tab" type="button" role="tab" aria-selected="true" aria-controls="panel-shows">Shows</button>
          <button id="tab-releases" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-releases" tabindex="-1">Releases</button>
          <button id="tab-identity" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-identity" tabindex="-1">IDENTITY</button>
          <button id="tab-bio" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-bio" tabindex="-1">Bio</button>
          <button id="tab-products" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-products" tabindex="-1">Products</button>
          <button id="tab-videos" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-videos" tabindex="-1">Videos</button>
        </div>
        </div>
        <section class="ed-now" aria-labelledby="now-h">
          <h2 id="now-h" class="ed-now-h">Today</h2>
          <div class="ed-now-grid">
            <div class="ed-now-item"><p class="ed-now-k">Next show</p><p class="ed-now-v" id="now-show">Loading...</p></div>
            <div class="ed-now-item"><p class="ed-now-k">IDENTITY</p><p class="ed-now-v" id="now-id">Loading...</p></div>
          </div>
          <p class="ed-now-note" id="now-note" hidden></p>
          <p class="ed-now-btns"><button class="ed-btn" type="button" data-go="add-show">Add show</button><button class="ed-btn" type="button" data-go="fix-release">Fix a release</button><button class="ed-btn" type="button" data-go="add-video">Add video</button></p>
        </section>
        <div id="panel-shows" class="ed-panel" role="tabpanel" aria-labelledby="tab-shows">
          <p class="ed-help">Change anything, then press Save. Past shows are grey: they stay on the Shows page under Played.</p>
          <button id="add" class="ed-btn ed-add" type="button">Add show</button>
          <ol id="list" class="ed-list"></ol>
          <details id="played" class="ed-played" hidden><summary class="ed-btn ed-plain">Played</summary><ol id="played-list" class="ed-list"></ol></details>
          <details id="hist-shows" class="ed-played ed-history"><summary class="ed-btn ed-plain">History</summary><div class="ed-hist"></div></details>
          <div class="ed-bar">
            <div id="undo-shows" class="ed-undo" role="status" hidden><p class="ed-undo-t"></p><button class="ed-btn ed-undo-b" type="button">Undo</button></div>
            <button id="save" class="ed-btn ed-main" type="button">Save shows</button>
            <div class="ed-say"><p id="msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/shows/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-releases" class="ed-panel" role="tabpanel" aria-labelledby="tab-releases" hidden>
          <p class="ed-help">Your releases, newest first. They show on the Music page; the newest one is also on Home. Change anything, then press Save.</p>
          <button id="r-add" class="ed-btn ed-add" type="button">Add release</button>
          <ol id="r-list" class="ed-list"></ol>
          <details id="hist-releases" class="ed-played ed-history"><summary class="ed-btn ed-plain">History</summary><div class="ed-hist"></div></details>
          <div class="ed-bar">
            <div id="undo-releases" class="ed-undo" role="status" hidden><p class="ed-undo-t"></p><button class="ed-btn ed-undo-b" type="button">Undo</button></div>
            <button id="r-save" class="ed-btn ed-main" type="button">Save releases</button>
            <div class="ed-say"><p id="r-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/music/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-identity" class="ed-panel" role="tabpanel" aria-labelledby="tab-identity" hidden>
          <p class="ed-help">IDENTITY’s countdown and Pre-save button, on Home and the Music page.</p>
          <div class="ed-field"><label for="i-date">Release date</label><input id="i-date" type="date" required /></div>
          <div class="ed-field"><label for="i-link">Pre-save link</label><input id="i-link" type="url" inputmode="url" maxlength="300" placeholder="https://" spellcheck="false" aria-describedby="i-link-hint i-link-fans" />
            <span id="i-link-hint" class="ed-hint">Where Pre-save goes. From release day the same button says Listen.</span>
            <p id="i-link-fans" class="ed-fans ed-hint" aria-live="off" hidden></p></div>
          <p id="i-today" class="ed-today"></p>
          <p class="ed-help">The ticket under your name on Home picks itself every day: a show today or tomorrow first, then a release coming or just out, then your next show. To change it, change Shows or Releases.</p>
          <details id="hist-identity" class="ed-played ed-history"><summary class="ed-btn ed-plain">History</summary><div class="ed-hist"></div></details>
          <div class="ed-bar">
            <button id="i-save" class="ed-btn ed-main" type="button">Save IDENTITY</button>
            <div class="ed-say"><p id="i-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/music/#identity" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-bio" class="ed-panel" role="tabpanel" aria-labelledby="tab-bio" hidden>
          <p class="ed-help">Your words on Home and the About page. Plain text.</p>
          <div class="ed-field"><label for="b-home">Home sentence</label><textarea id="b-home" rows="4" maxlength="400" aria-describedby="b-home-hint"></textarea>
            <span id="b-home-hint" class="ed-hint">Shows on Home under PUSH PAST FEAR. One or two sentences.</span></div>
          <div class="ed-field"><label for="b-bio">About bio</label><textarea id="b-bio" class="ed-bio" rows="14" maxlength="4000" aria-describedby="b-bio-hint"></textarea>
            <span id="b-bio-hint" class="ed-hint">Shows on the About page. Leave an empty line between paragraphs. Plain text: links and bold don’t work here.</span></div>
          <details id="hist-bio" class="ed-played ed-history"><summary class="ed-btn ed-plain">History</summary><div class="ed-hist"></div></details>
          <div class="ed-bar">
            <button id="b-save" class="ed-btn ed-main" type="button">Save bio</button>
            <div class="ed-say"><p id="b-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/about/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-products" class="ed-panel" role="tabpanel" aria-labelledby="tab-products" hidden>
          <p class="ed-help">Products show on the Shop page in this order. Use Move up and Move down. Change anything, then press Save.
            Fans buy on the store’s own page (the Link). This site never takes card details.</p>
          <button id="p-add" class="ed-btn ed-add" type="button">Add product</button>
          <ol id="p-list" class="ed-list"></ol>
          <details id="hist-products" class="ed-played ed-history"><summary class="ed-btn ed-plain">History</summary><div class="ed-hist"></div></details>
          <div class="ed-bar">
            <div id="undo-products" class="ed-undo" role="status" hidden><p class="ed-undo-t"></p><button class="ed-btn ed-undo-b" type="button">Undo</button></div>
            <h2 class="ed-bar-t">Products</h2>
            <button id="p-save" class="ed-btn ed-main" type="button">Save products</button>
            <div class="ed-say"><p id="p-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/shop/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-videos" class="ed-panel" role="tabpanel" aria-labelledby="tab-videos" hidden>
          <p class="ed-help">Your videos, newest first. Fans see them on Home and the Videos page. Hide one to take it off the site without losing it. Change anything, then press Save.</p>
          <button id="v-add" class="ed-btn ed-add" type="button">Add video</button>
          <ol id="v-list" class="ed-list"></ol>
          <details id="hist-videos" class="ed-played ed-history"><summary class="ed-btn ed-plain">History</summary><div class="ed-hist"></div></details>
          <div class="ed-bar">
            <button id="v-save" class="ed-btn ed-main" type="button">Save videos</button>
            <div class="ed-say"><p id="v-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/videos/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div class="ed-backup">
          <!-- COPY: docs/copy/backup.md --><a id="backup-link" class="ed-btn ed-plain" href="/edit/api/backup" download aria-describedby="backup-hint">Download a backup</a>
          <!-- COPY: docs/copy/backup.md --><p id="backup-hint" class="ed-hint">One file with your shows, products, photos and bio. Keep it somewhere safe.</p>
          <p id="backup-msg" class="ed-msg" role="status"></p>
        </div>
      </section>
    </main>
    <style is:global>
/* ---------- Admin console (/edit/): a tool, not the fan site. DESIGN.md section 15. Neutral chrome in the system font; the accent only on the one primary button, the active tab's bar and the focus ring. ---------- */
html[data-admin] {
  color-scheme: dark;
  --n1: #0f1117; --n2: #161922; --n3: #1e2230; --n4: #272c3d; --n5: #2e3345; --n6: #6b7186; --n7: #a3a9bb; --n8: #eceef4;
  --go: #6fdc9b; --go-bg: #11291d; --info: #93bdff; --info-bg: #14253f; --cau: #f0c463; --cau-bg: #2e2410; --crit: #ff9a9f; --crit-bg: #331418;
  --ring: var(--accent);
  --ed-font: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  --s1: .25rem; --s2: .5rem; --s3: .75rem; --s4: 1rem; --s6: 1.5rem; --s8: 2rem; --s12: 3rem;
  --r1: 6px; --r2: 8px; --r3: 12px;
  --side: 15rem;
  background: var(--n1); scrollbar-color: var(--n6) var(--n1);
  scroll-padding: 1rem 0 16rem; /* a focused field never hides under the sticky save bar */
}
html[data-admin][data-scheme='light'] {
  color-scheme: light;
  --n1: #f6f7f9; --n2: #ffffff; --n3: #eff1f5; --n4: #e3e6ee; --n5: #dadde6; --n6: #7f8597; --n7: #555b6c; --n8: #14161d;
  --go: #17663a; --go-bg: #e2f4e9; --info: #1d4f9e; --info-bg: #e4eeff; --cau: #75500c; --cau-bg: #fbf0d4; --crit: #a8202a; --crit-bg: #fde6e7;
  --ring: color-mix(in srgb, var(--accent) 70%, #000);
}
.ed-body { padding-bottom: 0; background: var(--n1); color: var(--n8); font-family: var(--ed-font); font-size: 1rem; line-height: 1.5; }
.ed-body ::selection { background: var(--n8); color: var(--n1); }
.ed-body :focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
.ed a:not(.ed-btn) { color: var(--n8); text-underline-offset: 3px; }

/* Shell, phone and tablet: one column, DOM order top to bottom. Not signed in: the name, then the sign-in card, left of centre. */
.ed { --gut: var(--s4); max-width: 28rem; margin: 0 var(--gut); padding: clamp(var(--s6), 12vh, 7rem) 0 var(--s12); }
@media (min-width: 600px) { .ed { margin-left: clamp(1rem, 10vw, 10rem); } }
.ed:has(> #editor:not([hidden])) { max-width: none; margin: 0; padding: var(--s3) var(--gut) 0; }
@media (min-width: 600px) { .ed:has(> #editor:not([hidden])) { --gut: var(--s8); max-width: 46rem; } }
.ed-title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s2); margin: 0; font-weight: 400; }
.ed-site { font-family: var(--font-display); font-weight: 900; font-size: 1.5rem; line-height: 1; text-transform: uppercase; }
.ed-title-t { font-size: 1.125rem; font-weight: 600; line-height: 1.3; color: var(--n7); }
.ed-title + .ed-help { max-width: 40rem; margin-top: var(--s3); padding: var(--s2) var(--s3); background: var(--info-bg); color: var(--n8); border: 1px solid var(--n5); border-left: 3px solid var(--info); border-radius: var(--r2); }
.ed-side { container-type: inline-size; display: grid; gap: var(--s3); margin-top: var(--s3); }
.ed-who { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s2); color: var(--n7); }
.ed-who-btns { display: flex; gap: var(--s2); }
#editor { display: block; }
.ed-now { margin-top: var(--s4); }
.ed-panel { margin-top: var(--s4); }
.ed-backup { display: grid; justify-items: start; gap: var(--s2); margin-top: var(--s6); padding: var(--s4) 0 var(--s8); border-top: 1px solid var(--n5); }

/* Desktop: a fixed left sidebar (name, who, tabs), content left-aligned beside it, the save bar docked on top. */
@media (min-width: 900px) and (min-height: 35rem) {
  html[data-admin] { scroll-padding: 6rem 0 2rem; }
  .ed:has(> #editor:not([hidden])) { width: auto; max-width: none; margin: 0; padding: 0 var(--s8) var(--s12) calc(var(--side) + var(--s8)); }
  .ed:has(> #editor:not([hidden])) .ed-title { position: fixed; inset: 0 auto auto 0; z-index: 11; width: var(--side); display: grid; gap: var(--s1); padding: var(--s6) var(--s4) var(--s3); background: var(--n2); }
  .ed:has(> #editor:not([hidden])) .ed-site { font-size: 1.75rem; }
  .ed:has(> #editor:not([hidden])) .ed-title-t { font-size: 1rem; font-weight: 400; line-height: 1.5; }
  .ed-side { position: fixed; inset: 0 auto 0 0; z-index: 10; width: var(--side); overflow-y: auto; display: flex; flex-direction: column; gap: var(--s4); margin: 0; padding: 6.25rem var(--s3) var(--s6); background: var(--n2); border-right: 1px solid var(--n5); }
  .ed-who { display: grid; gap: var(--s2); }
  .ed-who-btns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ed-who-btns .ed-btn { padding-inline: var(--s2); }
  #editor:not([hidden]) { display: grid; grid-template-columns: minmax(0, 60rem); align-items: start; row-gap: var(--s4); }
  .ed-now, .ed-panel { margin-top: 0; }
  .ed-panel:not([hidden]), .ed-backup { grid-column: 1; }
  .ed-now-grid { grid-template-columns: minmax(0, 1fr); }
}
@media (min-width: 1200px) and (min-height: 35rem) {
  #editor:not([hidden]) { grid-template-columns: minmax(0, 44rem) 18rem; column-gap: var(--s6); }
  .ed-row { grid-template-columns: 5.5rem 1fr auto; padding: var(--s2) var(--s4); }
  .ed-row-lead { display: flex; align-items: baseline; gap: .25em; white-space: nowrap; }
  .ed-row-date::after { content: ','; }
  .ed-row-head:has(.ed-row-date) { grid-template-columns: 7rem minmax(0, 1fr) auto; }
  .ed-now { grid-column: 2; grid-row: 1 / span 2; position: sticky; top: var(--s3); margin-top: 0; padding-top: var(--s2); }
}
@media (min-width: 600px) and (max-width: 1199.98px) { .ed-now-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 900px) and (min-height: 35rem) and (max-width: 1199.98px) { .ed-now-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

/* Sign-in card. */
.ed-card { display: grid; gap: var(--s1); margin-top: var(--s6); padding: var(--s6) var(--s4); background: var(--n2); border: 1px solid var(--n5); border-radius: var(--r3); }
.ed-card h2 { font-size: 1.25rem; font-weight: 600; line-height: 1.3; }
.ed-card > label, .ed-field > label, .ed-choices legend, .ed-lab { font-weight: 600; line-height: 1.5; }
.ed-card > label { margin-top: var(--s3); }
.ed-card .ed-main { width: 100%; margin-top: var(--s4); }

/* Tabs: a 3 x 2 segmented grid on phones, a vertical list in the sidebar. The open one: ground, weight and the accent bar. */
.ed-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s1); padding: var(--s1); background: var(--n2); border: 1px solid var(--n5); border-radius: var(--r3); }
@container (width < 17rem) { .ed-tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@container (width < 12rem) { .ed-tabs { grid-template-columns: minmax(0, 1fr); } }
.ed-tab { position: relative; min-height: 48px; padding: 0 var(--s1); font-family: var(--ed-font); font-size: 1rem; font-weight: 600; line-height: 1.2; text-align: center; color: var(--n7); background: transparent; border: 0; border-radius: var(--r2); transition: background-color 120ms ease-out, color 120ms ease-out, border-color 120ms ease-out; }
@media (hover: hover) { .ed-tab:not([aria-selected='true']):hover { background: var(--n3); color: var(--n8); } }
.ed-tab[aria-selected='true'] { background: var(--n4); color: var(--n8); }
.ed-tab[aria-selected='true']::before { content: ''; position: absolute; inset: auto var(--s4) var(--s1); height: 3px; border-radius: 2px; background: var(--ring); }
.ed-tab[data-dirty]::after { content: ''; position: absolute; top: var(--s2); right: var(--s2); box-sizing: border-box; width: .5rem; height: .5rem; border: 2px solid currentColor; border-radius: 50%; } /* unsaved: the hollow ring, never colour alone */
@media (min-width: 900px) and (min-height: 35rem) {
  .ed-tabs { grid-template-columns: minmax(0, 1fr); padding: var(--s3) 0 0; background: none; border: 0; border-top: 1px solid var(--n5); border-radius: 0; }
  .ed-tab { padding: 0 var(--s3); text-align: left; }
  .ed-tab[aria-selected='true']::before { inset: var(--s3) auto var(--s3) 0; width: 3px; height: auto; }
  .ed-tab[data-dirty]::after { top: 50%; right: var(--s3); translate: 0 -50%; }
}

/* Panels and the bar: one primary Save per tab. Phone: sticky at the bottom, full-bleed. Desktop: docked on top. */
.ed-panel:not([hidden]) { container-type: inline-size; display: flex; flex-direction: column; gap: var(--s3); padding-bottom: 5rem; }
.ed-help { max-width: 40rem; margin: 0; color: var(--n7); }
.ed-bar { position: sticky; bottom: 0; z-index: 5; display: grid; gap: var(--s2); margin-inline: calc(-1 * var(--gut)); padding: var(--s2) var(--gut) calc(var(--s2) + env(safe-area-inset-bottom)); background: var(--n1); border-top: 1px solid var(--n5); }
.ed-say { order: -1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); min-width: 0; }
.ed-say .ed-msg { margin-top: 0; }
.ed-say .ed-msg[data-state='error'] { flex: 1 1 100%; }
.ed-see { display: inline-flex; align-items: center; min-height: 48px; font-weight: 600; text-decoration: underline; }
.ed-see[hidden] { display: none; }
.ed-bar .ed-main { width: 100%; }
.ed-bar:has(.ed-msg[data-state='error']) { border-top: 2px solid var(--crit); }
.ed-draft { order: -2; }
@media (min-width: 900px) and (min-height: 35rem) {
  .ed-panel:not([hidden]) { padding-bottom: 0; }
  .ed-bar { order: -1; top: 0; bottom: auto; min-height: 4rem; margin-inline: 0; padding-block: var(--s2); padding-inline: 0; margin-bottom: var(--s2); background: var(--n1); border-top: 0; border-bottom: 1px solid var(--n5); grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--s4); align-items: center; }
  .ed-bar:has(.ed-msg[data-state='error']) { border-top: 0; border-bottom: 2px solid var(--crit); }
  .ed-say { order: 0; grid-column: 1; grid-row: 1; }
  .ed-bar .ed-main { grid-column: 2; grid-row: 1; width: auto; min-width: 8rem; height: 2.75rem; min-height: 0; border-radius: var(--r2); }
  .ed-undo { grid-column: 1 / -1; grid-row: 1; }
  .ed-bar:has(.ed-undo:not([hidden])) :is(.ed-say, .ed-main, .ed-bar-t) { grid-row: 2; }
