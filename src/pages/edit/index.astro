---
// Gabe's edit screen (Shows | Releases | IDENTITY | Bio | Products tabs). A static shell: public/js/edit.js signs in and builds the lists from
// /edit/api/shows, /edit/api/releases and /edit/api/products with createElement + textContent/value only. Not linked from the site; noindex.
import '../../styles/global.css';
import { era } from '../../components/content.js';

const HEX = /^#[0-9a-f]{6}$/i;
const eraCss = Object.entries(era.colors).filter(([, v]) => HEX.test(v)).map(([k, v]) => `--${k}:${v}`).join(';');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit the site | GLucak</title>
    <link rel="icon" href="data:," />
    <style set:html={`html:root{${eraCss}}`}></style>
    <script is:inline src="/js/edit.js" defer></script>
  </head>
  <body class="ed-body">
    <main class="ed">
      <h1 class="ed-title">Edit the site</h1>
      <noscript><p>This page needs JavaScript. Turn it on, then reload.</p></noscript>

      <form id="login" class="ed-card" method="post" action="/edit/login">
        <h2>Sign in</h2>
        <label for="username">Name</label>
        <input id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="64" />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="200" />
        <button class="ed-btn ed-main" type="submit">Sign in</button>
        <p id="login-msg" class="ed-msg" role="status"></p>
      </form>

      <section id="editor" hidden>
        <div class="ed-who"><span id="who"></span>
          <span class="ed-who-btns"><a class="ed-btn ed-plain" href="/" target="_blank" rel="noopener">View site</a>
          <button id="logout" class="ed-btn ed-plain" type="button">Sign out</button></span></div>
        <div id="out-ask" class="ed-ask" role="alert" hidden><p id="out-q">Not saved yet. Sign out anyway?</p>
          <p class="ed-ask-btns"><button id="out-yes" class="ed-btn" type="button">Sign out</button> <button id="out-no" class="ed-btn" type="button">Stay</button></p></div>
        <section class="ed-now" aria-labelledby="now-h">
          <h2 id="now-h" class="ed-now-h">Today</h2>
          <div class="ed-now-grid">
            <div class="ed-now-item"><p class="ed-now-k">Next show</p><p class="ed-now-v" id="now-show">Loading...</p></div>
            <div class="ed-now-item"><p class="ed-now-k">IDENTITY</p><p class="ed-now-v" id="now-id">Loading...</p></div>
          </div>
          <p class="ed-now-note" id="now-note" hidden></p>
          <p class="ed-now-btns"><button class="ed-btn" type="button" data-go="add-show">Add show</button><button class="ed-btn" type="button" data-go="fix-release">Fix a release</button><button class="ed-btn" type="button" data-go="add-video" hidden>Add video</button></p>
        </section>
        <div class="ed-tabs" role="tablist" aria-label="What to edit">
          <button id="tab-shows" class="ed-tab" type="button" role="tab" aria-selected="true" aria-controls="panel-shows">Shows</button>
          <button id="tab-releases" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-releases" tabindex="-1">Releases</button>
          <button id="tab-identity" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-identity" tabindex="-1">IDENTITY</button>
          <button id="tab-bio" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-bio" tabindex="-1">Bio</button>
          <button id="tab-products" class="ed-tab" type="button" role="tab" aria-selected="false" aria-controls="panel-products" tabindex="-1">Products</button>
        </div>
        <div id="panel-shows" class="ed-panel" role="tabpanel" aria-labelledby="tab-shows">
          <p class="ed-help">Change anything, then press Save. Past shows are grey: they stay on the Shows page under Played.</p>
          <button id="add" class="ed-btn ed-add" type="button">Add show</button>
          <ol id="list" class="ed-list"></ol>
          <details id="played" class="ed-played" hidden><summary class="ed-btn ed-plain">Played</summary><ol id="played-list" class="ed-list"></ol></details>
          <div class="ed-bar">
            <div id="undo-shows" class="ed-undo" role="status" hidden><p class="ed-undo-t"></p><button class="ed-btn ed-undo-b" type="button">Undo</button></div>
            <button id="save" class="ed-btn ed-main" type="button">Save shows</button>
            <div class="ed-say"><p id="msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/shows/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-releases" class="ed-panel" role="tabpanel" aria-labelledby="tab-releases" hidden>
          <p class="ed-help">Your releases, newest first. They show on the Music page; the newest one is also on Home. Change anything, then press Save.</p>
          <button id="r-add" class="ed-btn ed-add" type="button">Add release</button>
          <ol id="r-list" class="ed-list"></ol>
          <div class="ed-bar">
            <div id="undo-releases" class="ed-undo" role="status" hidden><p class="ed-undo-t"></p><button class="ed-btn ed-undo-b" type="button">Undo</button></div>
            <button id="r-save" class="ed-btn ed-main" type="button">Save releases</button>
            <div class="ed-say"><p id="r-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/music/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-identity" class="ed-panel" role="tabpanel" aria-labelledby="tab-identity" hidden>
          <p class="ed-help">IDENTITY’s countdown and Pre-save button, on Home and the Music page.</p>
          <div class="ed-field"><label for="i-date">Release date</label><input id="i-date" type="date" required /></div>
          <div class="ed-field"><label for="i-link">Pre-save link</label><input id="i-link" type="url" inputmode="url" maxlength="300" placeholder="https://" spellcheck="false" aria-describedby="i-link-hint" />
            <span id="i-link-hint" class="ed-hint">Where Pre-save goes. From release day the same button says Listen.</span></div>
          <p id="i-today" class="ed-today"></p>
          <p class="ed-help">The ticket under your name on Home picks itself every day: a show today or tomorrow first, then a release coming or just out, then your next show. To change it, change Shows or Releases.</p>
          <div class="ed-bar">
            <button id="i-save" class="ed-btn ed-main" type="button">Save IDENTITY</button>
            <div class="ed-say"><p id="i-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/music/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-bio" class="ed-panel" role="tabpanel" aria-labelledby="tab-bio" hidden>
          <p class="ed-help">Your words on Home and the About page. Plain text.</p>
          <div class="ed-field"><label for="b-home">Home sentence</label><textarea id="b-home" rows="4" maxlength="400" aria-describedby="b-home-hint"></textarea>
            <span id="b-home-hint" class="ed-hint">Shows on Home under PUSH PAST FEAR. One or two sentences.</span></div>
          <div class="ed-field"><label for="b-bio">About bio</label><textarea id="b-bio" class="ed-bio" rows="14" maxlength="4000" aria-describedby="b-bio-hint"></textarea>
            <span id="b-bio-hint" class="ed-hint">Shows on the About page. Leave an empty line between paragraphs. Plain text: links and bold don’t work here.</span></div>
          <div class="ed-bar">
            <button id="b-save" class="ed-btn ed-main" type="button">Save bio</button>
            <div class="ed-say"><p id="b-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/about/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div id="panel-products" class="ed-panel" role="tabpanel" aria-labelledby="tab-products" hidden>
          <p class="ed-help">Products show on the Shop page in this order. Use Move up and Move down. Change anything, then press Save.
            Fans buy on the store’s own page (the Link). This site never takes card details.</p>
          <button id="p-add" class="ed-btn ed-add" type="button">Add product</button>
          <ol id="p-list" class="ed-list"></ol>
          <div class="ed-bar">
            <div id="undo-products" class="ed-undo" role="status" hidden><p class="ed-undo-t"></p><button class="ed-btn ed-undo-b" type="button">Undo</button></div>
            <button id="p-save" class="ed-btn ed-main" type="button">Save products</button>
            <div class="ed-say"><p id="p-msg" class="ed-msg" role="status"></p><a class="ed-see text-link" href="/shop/" target="_blank" rel="noopener" hidden>See it on the site</a></div>
          </div>
        </div>
        <div class="ed-backup">
          <!-- COPY: docs/copy/backup.md --><a id="backup-link" class="ed-btn ed-plain" href="/edit/api/backup" download aria-describedby="backup-hint">Download a backup</a>
          <!-- COPY: docs/copy/backup.md --><p id="backup-hint" class="ed-hint">One file with your shows, products, photos and bio. Keep it somewhere safe.</p>
          <p id="backup-msg" class="ed-msg" role="status"></p>
        </div>
      </section>
    </main>
    <style is:global>
/* ---------- Admin console (/edit/): plain, big, the same tokens ---------- */
.ed-body { padding-bottom: 0; color-scheme: dark; } /* dark native pickers: the date / time icons stay visible on bg */
html:has(.ed-body) { scroll-padding: 1rem 0 16rem; } /* a focused field never hides under the sticky save bar */
.ed { width: min(100% - 2 * var(--space-m), 46rem); margin-inline: auto; padding-top: var(--space-xl); }
.ed-title { font-family: var(--font-display); font-weight: 900; font-size: var(--step-3); line-height: 0.9; text-transform: uppercase; }
.ed-proto { margin-top: var(--space-xs); }
/* Sign-in: a card with the band's 4px top edge. */
.ed-card { max-width: 28rem; margin-top: var(--space-l); padding: var(--space-l); background: var(--bg-2); border: 2px solid var(--line); border-top: 4px solid var(--text); border-radius: var(--radius-s); }
.ed-card h2 { font-family: var(--font-display); font-weight: 900; font-size: var(--step-2); line-height: 1; text-transform: uppercase; }
.ed-card > label, .ed-field > label { display: block; margin-top: var(--space-m); font-weight: 700; font-size: 1.0625rem; line-height: 1.3; }
/* Fields: 52px, bg ground, a muted border (3:1+ against bg and bg-2 in every era), 3px text focus ring. */
.ed input:not([type='file']):not([type='radio']), .ed select, .ed textarea {
  display: block; width: 100%; min-height: 52px; margin-top: 0.3rem; padding: 0.5rem 0.75rem;
  font: inherit; font-size: var(--step-0); color: var(--text); background: var(--bg);
  border: 2px solid var(--muted); border-radius: var(--radius-s);
}
.ed textarea { min-height: 7.5rem; resize: vertical; line-height: 1.4; }
.ed input:focus-visible, .ed select:focus-visible, .ed textarea:focus-visible { outline: 3px solid var(--text); outline-offset: 2px; border-color: var(--text); }
.ed ::placeholder { color: var(--muted); opacity: 1; }
.ed-hint { display: block; margin-top: 0.3rem; font-size: var(--step--1); line-height: 1.35; color: var(--muted); }
.ed-two { display: grid; gap: 0 var(--space-m); }


/* Status: radio rows with the full option words (a closed <select> cut them off at 390). The checked row is outlined in
   text and its dot filled; the whole row is the target. */
.ed-choices { min-width: 0; margin: var(--space-m) 0 0; padding: 0; border: 0; display: grid; gap: var(--space-xs); }
.ed-choices legend { padding: 0; margin-bottom: 0.3rem; font-weight: 700; font-size: 1.0625rem; line-height: 1.3; }
.ed-choice {
  display: flex; align-items: center; gap: 0.75rem; min-height: 52px; padding: 0.4rem 0.75rem;
  background: var(--bg); border: 2px solid var(--muted); border-radius: var(--radius-s); line-height: 1.3; cursor: pointer;
}
.ed-choice:has(input:checked) { border: 3px solid var(--text); font-weight: 700; }
.ed .ed-choice input { flex: none; width: 1.5rem; height: 1.5rem; min-height: 0; margin: 0; accent-color: var(--text); }
.ed-choice:has(input:focus-visible) { outline: 3px solid var(--text); outline-offset: 2px; }

/* Buttons. ed-main is the site's .btn look (display face, accent): the one thing to press. */
.ed-btn {
  display: inline-flex; align-items: center; justify-content: center; min-height: 48px; min-width: 48px; padding: 0.5rem 1rem;
  font-weight: 700; font-size: 1.0625rem; line-height: 1.2; text-align: center;
  color: var(--text); background: var(--bg); border: 2px solid var(--text); border-radius: var(--radius-s);
}
.ed-main {
  min-height: 56px; background: var(--accent); color: var(--accent-text); border-color: var(--accent);
  font-family: var(--font-display); font-weight: 900; font-size: 1.5rem; letter-spacing: 0.02em; text-transform: uppercase;
}
.ed-card .ed-main { width: 100%; margin-top: var(--space-l); }
.ed-plain { border-color: var(--muted); }
.ed-add { width: 100%; min-height: 56px; margin-top: var(--space-m); border-style: dashed; border-width: 3px; } /* an empty slot to fill */
.ed-btn:disabled { color: var(--muted); border-color: var(--line); border-style: dashed; cursor: not-allowed; }
.ed-main[aria-disabled='true'] { background: var(--bg); color: var(--text); border-color: var(--text); border-style: dashed; cursor: progress; }
.ed-btn:not(:disabled):not([aria-disabled='true']):active { background: var(--text); color: var(--bg); border-color: var(--text); }
.ed-edit[aria-expanded='true'] { background: var(--text); color: var(--bg); }
@media (hover: hover) {
  .ed-btn:not(:disabled):not([aria-disabled='true']):hover { background: var(--text); color: var(--bg); border-color: var(--text); }
}

/* Played: a closed fold after the upcoming shows. */
.ed-played { margin-block: var(--space-m) var(--space-l); }
.ed-played > summary { display: flex; width: 100%; min-height: 52px; justify-content: flex-start; cursor: pointer; list-style: none; }
.ed-played > summary::-webkit-details-marker { display: none; }
.ed-played > summary::before { content: ''; width: 0.5rem; height: 0.5rem; margin-right: 0.75rem; border: solid currentColor; border-width: 0 3px 3px 0; rotate: -45deg; }
.ed-played[open] > summary::before { rotate: 45deg; }
.ed-played > .ed-list { margin-bottom: 0; }
.ed-today { margin-top: var(--space-m); font-size: var(--step--1); line-height: 1.35; color: var(--text); font-weight: 700; }
.ed-bio { min-height: 20rem; }
/* Backup: one plain link under both tabs (both lists and the photos go in one file). */
.ed-backup { margin-block: var(--space-l) var(--space-xl); padding-top: var(--space-m); border-top: 2px dashed var(--line); }
.ed-who-btns { display: flex; gap: var(--space-xs); }
.ed-who { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-xs) var(--space-m); margin-top: var(--space-l); font-weight: 700; }
/* Sign out with unsaved changes: the paper box, two plain buttons (D41 F3: one accent button per view, and that is Save). */
.ed-ask { margin-top: var(--space-m); padding: var(--space-m); background: var(--text); color: var(--bg); font-weight: 700; }
.ed-ask-btns { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-xs); margin-top: var(--space-s); }

/* Today: the sign-in card's look (4px text top edge). Values wrap, never cut. */
.ed-now { margin-top: var(--space-m); padding: var(--space-s); background: var(--bg-2); border: 2px solid var(--line); border-top: 4px solid var(--text); border-radius: var(--radius-s); }
.ed-now-h { font-family: var(--font-display); font-weight: 900; font-size: var(--step-1); line-height: 1; text-transform: uppercase; }
.ed-now-grid { display: grid; gap: var(--space-s); margin-top: var(--space-s); }
@media (min-width: 600px) { .ed-now-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.ed-now-item { min-width: 0; }
.ed-now-k { font-size: 1rem; font-weight: 700; line-height: 1.3; color: var(--muted); }
.ed-now-v { font-weight: 800; font-size: var(--step-0); line-height: 1.25; overflow-wrap: anywhere; color: var(--text); }
.ed-now-note { margin-top: var(--space-xs); font-size: 1rem; font-weight: 700; color: var(--text); }
.ed-now-btns { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 0.5rem; margin-top: var(--space-s); }
.ed-now-btns .ed-btn { padding-inline: 0.5rem; }
.ed-now-btns [hidden] { display: none; }
/* Undo bar: the paper box, first thing in the save bar. Appears and goes at once; no timer. */
.ed-undo { order: -2; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-s); padding: 0.6rem 0.75rem; background: var(--text); color: var(--bg); font-weight: 700; }
.ed-undo[hidden] { display: none; }
.ed-undo-t { flex: 1 1 10rem; min-width: 0; overflow-wrap: anywhere; }
.ed-undo-b { flex: none; min-width: 6rem; }
/* Tabs: five now, six when Videos comes (A3). Phones: three then two (the fifth spans two, only when it is the last); six get three equal cells. One row from 36rem. */
/* The open one is inverted (text ground, bg letters), like the site's crate tabs. */
.ed-tab:nth-child(5):last-child { grid-column: span 2; } /* phones, five tabs only: Shows Releases IDENTITY / Bio Products */
.ed-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2px; margin-top: var(--space-m); background: var(--text); border: 2px solid var(--text); border-radius: var(--radius-s); } /* the 2px gap draws the rules between cells */
@container (min-width: 36rem) { .ed-tabs { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); grid-template-columns: none; } .ed-tab:nth-child(5):last-child { grid-column: auto; } }
@container (width < 17rem) { .ed-tabs { grid-template-columns: minmax(0, 1fr); } .ed-tab:last-child { grid-column: auto; } }
@container (width < 17rem) { .ed-tab:nth-child(5):last-child { grid-column: auto; } }
.ed-tab { min-height: 52px; padding: 0.4rem 0.25rem; font: inherit; font-weight: 800; font-size: 1.0625rem; color: var(--text); background: var(--bg); border: 0; }
.ed-tab[data-dirty]::after { content: ''; display: inline-block; width: 0.6rem; height: 0.6rem; margin-left: 0.4rem; border: 2px solid currentColor; border-radius: 50%; } /* unsaved: the dirty ring, never colour alone */
.ed-tab[aria-selected='true'] { background: var(--text); color: var(--bg); }
.ed-tab:focus-visible { outline: 3px solid var(--text); outline-offset: 3px; }
.ed-help { max-width: 40rem; margin-top: var(--space-m); color: var(--muted); }
.ed-empty { padding: var(--space-l) var(--space-m); border: 2px dashed var(--muted); color: var(--text); font-weight: 700; }

/* Rows: collapsed to a head (picture or date, number, name, status) and the actions; Edit opens the form under them. */
.ed-list { display: grid; gap: var(--space-xs); margin-block: var(--space-m) var(--space-l); }
.ed-row { min-width: 0; padding: 0.375rem 0.375rem 0.375rem 0.75rem; background: var(--bg-2); border: 2px solid var(--line); border-radius: var(--radius-s); }
.ed-row.is-open { border-color: var(--text); }
.ed-row.past { border-style: dashed; }
.ed-row.past .ed-row-title, .ed-row.past .ed-row-date { color: var(--muted); } /* "Past shows are grey" (copy), still 4.5:1 */
.ed-row.bad { border: 3px solid var(--text); }
.ed-row.bad .ed-row-num::after {
  content: '!'; display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; margin-left: 0.5rem;
  background: var(--text); color: var(--bg); font-weight: 800; vertical-align: middle;
}
.ed-row-head { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 0.25rem 0.75rem; align-items: start; }
.ed-row-head:has(.ed-row-date) { grid-template-columns: 4.25rem minmax(0, 1fr) auto; }
.ed-edit { min-width: 4.5rem; }
.ed-row-head .ed-err { grid-column: 1 / -1; }
.ed-row-head > .ed-edit { grid-column: 3; grid-row: 1; }
.ed-thumb, .ed-pic { object-fit: cover; background-color: var(--bg); background-image: var(--hatch); border: 2px solid var(--line); }
.ed-thumb { width: 48px; height: 48px; }
.ed-row-date { font-family: var(--font-display); font-weight: 900; font-size: 1.5rem; line-height: 1; text-transform: uppercase; white-space: nowrap; }
.ed-row-text { min-width: 0; align-self: center; }
.ed-row-year { font-size: var(--step--1); font-weight: 700; line-height: 1.2; color: var(--muted); }
.ed-row-num { font-size: var(--step--1); font-weight: 700; line-height: 1.3; color: var(--muted); }
.ed-row-title { font-weight: 800; font-size: var(--step-0); line-height: 1.25; }
.ed-row-title { overflow-wrap: anywhere; }
.ed-row-title:empty { display: none; }
.ed-row-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; font-size: var(--step--1); line-height: 1.3; color: var(--muted); }
.ed-row-meta .product-status { color: var(--text); }
.ed-price { font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }
.ed-tag { flex: none; padding: 0 0.4rem; border: 2px solid var(--muted); color: var(--text); font-weight: 700; }
/* Inside the open form: Products start with Move up | Move down; every form ends with a dashed rule and Delete. */
.ed-move { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xs); margin-top: var(--space-s); }
.ed-delete { margin-top: var(--space-l); padding-top: var(--space-m); border-top: 2px dashed var(--line); }
.ed-err { grid-column: 1 / -1; }
.ed-thumb, .ed-pic { object-fit: cover; background-color: var(--bg); background-image: var(--hatch); border: 2px solid var(--line); }
.ed-thumb { width: 48px; height: 48px; }
.ed-row-date { font-family: var(--font-display); font-weight: 900; font-size: 1.5rem; line-height: 1; text-transform: uppercase; white-space: nowrap; }
.ed-row-text { min-width: 0; }
.ed-row-num { font-size: var(--step--1); font-weight: 700; line-height: 1.3; color: var(--muted); }
.ed-row-title { font-weight: 800; font-size: var(--step-0); line-height: 1.25; }
.ed-row-title { overflow-wrap: anywhere; }
.ed-row-title:empty { display: none; }
.ed-row-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; font-size: var(--step--1); line-height: 1.3; color: var(--muted); }
.ed-row-meta .product-status { color: var(--text); }
.ed-price { font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }
.ed-tag { flex: none; padding: 0 0.4rem; border: 2px solid var(--muted); color: var(--text); font-weight: 700; }
/* Products: Move up | Move down / Edit | Delete in a 2x2 grid on phones (each about 122px at 320), one row of four from
   600px. Shows: Edit | Delete. Same place on every row, so Gabe’s thumb learns it. */
.ed-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xs); margin-top: var(--space-s); }
.ed-actions .ed-btn { padding-inline: 0.5rem; }
@media (min-width: 600px) {
  .ed-actions-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ed-actions:not(.ed-actions-4) { grid-template-columns: repeat(2, minmax(0, 9rem)); }
}
.ed-err { margin-top: var(--space-xs); padding: 0.5rem 0.75rem; background: var(--text); color: var(--bg); font-weight: 700; line-height: 1.35; }
.ed-err:empty { display: none; }

/* The editor form, under its row. */
.ed-form { min-width: 0; margin: var(--space-m) 0 0; padding: var(--space-xs) 0 0; border: 0; border-top: 2px dashed var(--line); }
/* Photo: preview (hatched until there is one), then the upload button, its hint and the message ("Uploading…" busy). */
.ed-upload { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: var(--space-m); align-items: start; margin-top: var(--space-s); }
.ed-pic { width: 120px; height: 120px; }
@media (max-width: 399px) { .ed-upload { grid-template-columns: 1fr; } }
.ed-upload-side { min-width: 0; }
.ed-file-wrap { position: relative; display: flex; }
.ed-file { width: 100%; min-height: 56px; border-width: 3px; }
.ed-file-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
.ed-file-wrap:has(.ed-file-input:focus-visible) .ed-file { outline: 3px solid var(--text); outline-offset: 3px; }
@media (hover: hover) { .ed-file-wrap:hover .ed-file { background: var(--text); color: var(--bg); } }

/* Messages: one look for every message line (sign-in, upload, save). data-state draws a glyph, never colour alone:
   dirty = hollow ring, busy = half-filled ring (static), ok = a tick, error = the paper box with a "!" square. */
.ed-msg, .ed-upmsg { display: flex; align-items: flex-start; gap: 0.6rem; margin-top: var(--space-s); font-weight: 700; font-size: var(--step--1); line-height: 1.35; color: var(--text); }
.ed-msg { font-size: var(--step-0); }
.ed-msg:empty, .ed-upmsg:empty { display: none; }
:is(.ed-msg, .ed-upmsg)[data-state]::before { content: ''; flex: none; width: 1rem; height: 1rem; margin-top: 0.2rem; }
:is(.ed-msg, .ed-upmsg)[data-state='dirty']::before { border: 2px solid currentColor; border-radius: 50%; }
:is(.ed-msg, .ed-upmsg)[data-state='busy']::before { border: 2px solid currentColor; border-radius: 50%; background: linear-gradient(90deg, currentColor 50%, transparent 50%); }
:is(.ed-msg, .ed-upmsg)[data-state='ok']::before { width: 0.5rem; height: 0.95rem; margin: 0 0.3rem 0 0.25rem; border: solid currentColor; border-width: 0 3px 3px 0; rotate: 45deg; }
:is(.ed-msg, .ed-upmsg)[data-state='error'] { padding: 0.6rem 0.75rem; background: var(--text); color: var(--bg); }
:is(.ed-msg, .ed-upmsg)[data-state='error']::before {
  content: '!'; display: grid; place-items: center; width: 1.4rem; height: 1.4rem; margin-top: 0;
  background: var(--bg); color: var(--text); font-weight: 800; line-height: 1;
}

/* The save bar: sticky at the bottom of its tab. Message above the button on phones (read, then press), beside it from
   700px. Unsaved or failed: the bar’s top edge goes to 4px text. */
.ed-bar {
  position: sticky; bottom: 0; z-index: 5; display: grid; gap: var(--space-xs);
  padding: var(--space-s) 0 calc(var(--space-s) + env(safe-area-inset-bottom));
  background: var(--bg); border-top: 2px solid var(--line);
}
.ed-say { order: -1; display: flex; flex-wrap: wrap; align-items: center; gap: 0 1rem; min-width: 0; }
.ed-say .ed-msg { margin-top: 0; }
.ed-see { display: inline-flex; align-items: center; min-height: 48px; font-weight: 700; }
.ed-see[hidden] { display: none; }
.ed-bar .ed-main { width: 100%; }
.ed-bar:has(.ed-msg[data-state='dirty']), .ed-bar:has(.ed-msg[data-state='error']) { border-top: 4px solid var(--text); }
@media (min-width: 700px) {
  .ed-bar { grid-template-columns: minmax(0, 1fr) 16rem; align-items: center; column-gap: var(--space-m); }
  .ed-say { order: 0; grid-column: 1; grid-row: 1; }
  .ed-bar .ed-main { grid-column: 2; grid-row: 1; }
  .ed-undo { grid-column: 1 / -1; grid-row: 1; }
  .ed-bar:has(.ed-undo:not([hidden])) :is(.ed-say, .ed-main) { grid-row: 2; }
}

/* Admin console. Tabs cause: a 1fr | 1fr grid, PRODUCTS wider than half the card at 200%: clipped. Now a wrapping flex
   row: two equal halves while both words fit, else one tab per row. */
/* Rows and fields: under 17rem (200% on a phone) the row's 1rem padding and the 4.25rem date column left the place and
   the status words no room. The date / picture sits over the text; padding halves. */
.ed { container-type: inline-size; }
@container (width < 17rem) {
  .ed-row { padding: var(--space-s) var(--space-xs); }
  .ed-row-head, .ed-row-head:has(.ed-row-date) { grid-template-columns: minmax(0, 1fr); }
  .ed-choice { padding-inline: var(--space-xs); gap: var(--space-xs); }
  .ed-choice span { min-width: 0; overflow-wrap: anywhere; }
}
/* Date / time fields: the native date input's own minimum width (about 354px at 200%) pushed its grid column off the
   screen. Fields may shrink; the input still fills its field. */
.ed-two { grid-template-columns: minmax(0, 1fr); }
@media (min-width: 480px) { .ed-two { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
.ed-field { min-width: 0; }
        </style>
  </body>
</html>
