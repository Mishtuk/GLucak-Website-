---
// Gabe's edit screen (v1: shows only). A static shell: public/js/edit.js signs in and builds the list from
// /edit/api/shows with createElement + textContent/value only. Not linked from the site; noindex.
import '../../styles/global.css';
import { era } from '../../components/content.js';

const HEX = /^#[0-9a-f]{6}$/i;
const eraCss = Object.entries(era.colors).filter(([, v]) => HEX.test(v)).map(([k, v]) => `--${k}:${v}`).join(';');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Edit shows | GLucak</title>
    <link rel="icon" href="data:," />
    <style set:html={`:root{${eraCss}}`}></style>
    <script is:inline src="/js/edit.js" defer></script>
  </head>
  <body class="ed-body">
    <main class="ed">
      <h1 class="ed-title">Edit shows</h1>
      <noscript><p>This page needs JavaScript. Turn it on, then reload.</p></noscript>

      <form id="login" class="ed-card" method="post" action="/edit/login">
        <h2>Sign in</h2>
        <label for="username">Name</label>
        <input id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required maxlength="64" />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="200" />
        <button class="ed-btn ed-main" type="submit">Sign in</button>
        <p id="login-msg" class="ed-msg" role="status"></p>
      </form>

      <section id="editor" hidden>
        <p class="ed-who"><span id="who"></span> <button id="logout" class="ed-btn ed-plain" type="button">Sign out</button></p>
        <p class="ed-help">Change anything, then press Save. Past shows are grey: they stay on the Shows page under Played.</p>
        <button id="add" class="ed-btn" type="button">Add show</button>
        <ol id="list" class="ed-list"></ol>
        <div class="ed-bar">
          <button id="save" class="ed-btn ed-main" type="button">Save</button>
          <p id="msg" class="ed-msg" role="status"></p>
        </div>
      </section>
    </main>
    <style is:global>
      [hidden] { display: none !important; }
      .ed-body { padding-bottom: 0; }
      .ed { width: min(100% - 2 * var(--space-m), 44rem); margin-inline: auto; padding-block: var(--space-xl); }
      .ed-title { font-family: var(--font-display); font-weight: 900; text-transform: uppercase; font-size: var(--step-3); line-height: 1; margin-bottom: var(--space-l); }
      .ed h2 { font-size: var(--step-1); margin-bottom: var(--space-s); }
      .ed label { display: block; margin-top: var(--space-m); font-weight: 700; }
      .ed input, .ed select {
        display: block; width: 100%; min-height: 48px; margin-top: 0.25rem; padding: 0.5rem 0.75rem;
        font: inherit; font-size: var(--step-0); color: var(--text); background: var(--bg);
        border: 2px solid var(--line); border-radius: var(--radius-s);
      }
      .ed input:focus-visible, .ed select:focus-visible { outline: 3px solid var(--text); outline-offset: 1px; border-color: var(--text); }
      .ed-hint { font-size: var(--step--1); color: var(--muted); }
      .ed-card, .ed-show { padding: var(--space-l); background: var(--bg-2); border: 2px solid var(--line); border-radius: var(--radius-s); }
      .ed-btn {
        min-height: 48px; min-width: 48px; padding: 0.5rem 1.25rem; margin-top: var(--space-m);
        font-weight: 700; font-size: var(--step-0); color: var(--text); background: var(--bg);
        border: 2px solid var(--text); border-radius: var(--radius-s);
      }
      .ed-main { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
      .ed-plain { margin-top: 0; border-color: var(--line); }
      .ed-who { display: flex; align-items: center; justify-content: space-between; gap: var(--space-m); flex-wrap: wrap; }
      .ed-help { margin-top: var(--space-m); color: var(--muted); }
      .ed-list { display: grid; gap: var(--space-l); margin-block: var(--space-l); }
      .ed-show { min-width: 0; }
      .ed-show legend { padding-inline: 0.25rem; font-weight: 700; }
      .ed-show.past { opacity: 0.6; }
      .ed-show.bad { border-color: var(--accent); }
      .ed-tag { margin-left: 0.5rem; font-weight: 400; color: var(--muted); }
      .ed-two { display: grid; gap: 0 var(--space-m); }
      @media (min-width: 560px) { .ed-two { grid-template-columns: 1fr 1fr; } }
      .ed-err { margin-top: var(--space-s); font-weight: 700; color: var(--text); }
      .ed-err:empty, .ed-msg:empty { display: none; }
      .ed-err::before { content: '! '; color: var(--accent); }
      .ed-msg { margin-top: var(--space-s); font-weight: 700; }
      .ed-bar { position: sticky; bottom: 0; padding-block: var(--space-s) calc(var(--space-s) + env(safe-area-inset-bottom)); background: var(--bg); border-top: 2px solid var(--line); }
      .ed-bar .ed-btn { margin-top: 0; width: 100%; }
    </style>
  </body>
</html>
