---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found - GLucak" description="That page isn't here. The music is.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="band band-lost lost" aria-labelledby="h-lost">
    <div class="wrap">
      <span class="tab tab-blank" aria-hidden="true"></span>
      <h1 class="lost-title fit" id="h-lost"><span class="ln ln-lost1">Wrong</span> <span class="ln ln-lost2">turn.</span></h1>
      <p class="lost-line">That page isn't here. The music is.</p>
      <div class="lost-actions">
        <a class="btn btn-solid" href="/music/" aria-label="Listen to GLucak's music">Listen</a>
        <a class="go" href="/shows/" aria-label="See upcoming shows">Shows</a>
      </div>
      <p class="lost-home"><a class="text-link" href="/" aria-label="Back to the home page">Home</a></p>
    </div>
  </section>
</Base>
