---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RiseBand from '../components/RiseBand.astro';
import VideoBlock from '../components/VideoBlock.astro';
import Signup from '../components/Signup.astro';
import { PATREON, identity } from '../components/content.js';
const idn = identity();

const HERO = 'a'; // D14: 'a' = GLUCAK over a full-bleed photo (default), 'b' = photo set into the name
---
<Base title="GLucak" home hero={HERO}>
  <div class="top">
    <div class="glow" aria-hidden="true"></div>
    <Hero variant={HERO} />
    <RiseBand />
  </div>

  <section class="band band-live" id="shows" aria-labelledby="h-live">
    <div class="wrap">
      <h2 class="spine fade" id="h-live"><span class="tab">Shows</span> <span class="phrase fit"><span class="ln ln-live">Live It Loud</span></span></h2>
      <div class="shows-grid">
        <div id="shows-mount"><Fragment set:html="<!--gl:shows-->" /></div>
        <VideoBlock />
      </div>
    </div>
  </section>

  <section class="band band-push" id="about" aria-labelledby="h-push">
    <div class="push-head">
      <picture>
        <source type="image/webp" srcset="/media/live-1200.webp 1200w, /media/live-2400.webp 2400w" sizes="100vw" />
        <img class="duo push-photo" src="/media/live-1200.jpg" alt="" width="2400" height="1600" loading="lazy" />
      </picture>
      <div class="wrap push-title">
        <h2 class="spine fade" id="h-push"><span class="tab">About</span> <span class="phrase fit lock-push"><span class="ln ln-push1">Push Past</span> <span class="ln ln-push2">Fear</span></span></h2>
      </div>
    </div>
    <div class="wrap push-body">
      <div class="bio">
        <p class="bio-lead">Despite facing various difficulties and struggles over the years, Epilepsy survivor and Producer-Rapper/DJ GLucak has shown no intent to give up on either his Faith in God or his mission in creating energetic music to bring others to Christ.</p>
        <p class="muted mission">The mission statement has always been the same: Rise, Live It Loud, Push Past Fear, The Time Is Now.</p>
      </div>
      <div class="push-actions">
        <a class="btn btn-solid" href={PATREON} rel="noopener">Patreon</a>
        <a class="btn btn-line" href="/about/">About GLucak</a>
      </div>
    </div>
  </section>

  <section class="band band-now" id="join" aria-labelledby="h-now">
    <div class="wrap">
      <h2 class="spine fade" id="h-now"><span class="tab">Join</span> <span class="phrase fit lock-now"><span class="ln ln-now1">The Time</span> <span class="ln ln-now2">Is Now</span></span></h2>
      <div class="now-grid">
        <Signup />
        {idn.date ? (
          <div class="identity-state">
            <p class="identity">IDENTITY</p>
            {idn.out
              ? <p class="identity-when">Out now. <a class="text-link" href={idn.link} rel="noopener">Listen</a></p>
              : <><p class="identity-when"><time datetime={idn.date}>{idn.pretty}</time> &middot; {idn.days} {idn.days === 1 ? 'day' : 'days'} to go</p>
                 <a class="btn btn-line" href={idn.link} rel="noopener">Pre-save IDENTITY</a></>}
          </div>
        ) : <p class="identity">IDENTITY</p>}
      </div>
    </div>
  </section>
</Base>
