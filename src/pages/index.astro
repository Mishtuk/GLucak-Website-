---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RiseBand from '../components/RiseBand.astro';
import VideoBlock from '../components/VideoBlock.astro';
import Signup from '../components/Signup.astro';
import { PATREON, PATREON_LINE, PHOTO_CREDITS as C, SITE_URL, SOCIALS, era } from '../components/content.js';
import site from '../data/site.json';
import { homeBioHtml, identityHtml } from '../lib/site.js';

// MusicGroup + WebSite JSON-LD (data, not script: CSP ignores it). '<' escaped so nothing can close the tag.
const ld = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'MusicGroup', name: 'GLucak', url: `${SITE_URL}/`, logo: `${SITE_URL}/media/apple-touch-icon-180.png`, image: `${SITE_URL}/media/og/home.png`,
    genre: ['EDM', 'Hip-Hop/Rap', 'Rock'], sameAs: SOCIALS.map((s) => s.href) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'GLucak', url: `${SITE_URL}/` },
]).replace(/</g, '\\u003c');

const HERO = 'ab'; // D34: A (GLUCAK over the photo) under 900px, B (photo in the name) from 900px up (DESIGN 29: no other variant)
---
<Base title="GLucak | Producer-Rapper and DJ from Horsham, PA" description="GLucak: independent producer-rapper and DJ from Horsham, PA. EDM, rap and rock with raw, faith-based lyrics. New music, shows and videos." home hero={HERO} credits={[C.kealey, C.joseph, C.yt, C.vladd, C.cd, C.identity]}>
  <script type="application/ld+json" slot="head" set:html={ld}></script>
  <div class="top">
    <Hero />
    <RiseBand />
  </div>

  <section class="band band-live edge-angle" id="shows" aria-labelledby="h-live">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine" id="h-live"><span class="tab">Shows</span> <span class="phrase fit"><span class="ln ln-live">Live It Loud</span></span></h2>
        <img class="v2-photo v2-wide-only v2-tall print" src="/media/v2/stage-lines-360.webp" srcset="/media/v2/stage-lines-360.webp 360w, /media/v2/stage-lines-634.webp 634w" sizes="40vw" width="634" height="1128" alt="GLucak singing on stage at Crooked Eye Brewery" loading="lazy" />
      </div>
      <div class="v2-main">
        <div id="shows-mount"><Fragment set:html="<!--gl:shows-->" /></div>
        <VideoBlock />
      </div>
    </div>
  </section>

  <section class="band band-push v2-push" id="about" aria-labelledby="h-push">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine" id="h-push"><span class="tab">About</span> <span class="phrase fit lock-push"><span class="ln ln-push1">Push Past</span> <span class="ln ln-push2">Fear</span></span></h2>
      </div>
      <div class="v2-main v2-push-body">
        <img class="v2-photo v2-belt print" src="/media/v2/belt-print-320.webp" srcset="/media/v2/belt-print-320.webp 320w, /media/v2/belt-print-634.webp 634w" sizes="(min-width: 900px) 40vw, 30vw" width="634" height="1128" alt="GLucak live at Crooked Eye Brewery, arm raised" loading="lazy" />
        <p class="bio-lead v2-bio"><Fragment set:html={homeBioHtml(site)} /></p>
        <div class="push-actions">
          <p class="patreon-line">{PATREON_LINE}</p>
          <a class="btn btn-line" href={PATREON} rel="noopener">Patreon</a>
          <a class="go" href="/about/">Full bio</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-now" id="join" aria-labelledby="h-now">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine" id="h-now"><span class="tab">Join</span> <span class="phrase fit lock-now"><span class="ln ln-now1">The Time</span> <span class="ln ln-now2">Is Now</span></span></h2>
      </div>
      <div class="v2-main now-grid">
        <Signup />
        <div class="v2-identity">
          <img class="v2-photo" src="/media/covers/identity-320.webp" srcset="/media/covers/identity-320.webp 320w, /media/covers/identity.webp 640w" sizes="(min-width: 900px) 12rem, 26vw" width="640" height="640" alt="IDENTITY cover art" loading="lazy" />
          <div class="identity-state">
            {era.mark && <img class="mark mark-identity" src={era.mark} alt="" width="300" height="96" loading="lazy" />}
            <p class="identity">IDENTITY</p>
            <Fragment set:html={identityHtml(site)} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
