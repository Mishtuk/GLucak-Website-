---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import RiseBand from '../components/RiseBand.astro';
import VideoBlock from '../components/VideoBlock.astro';
import Signup from '../components/Signup.astro';
import Quote from '../components/Quote.astro';
import PushPhoto from '../components/PushPhoto.astro';
import { PATREON, PHOTO_CREDITS as C, SITE_URL, SOCIALS, era, identity } from '../components/content.js';
const idn = identity();

// MusicGroup + WebSite JSON-LD (data, not script: CSP ignores it). '<' escaped so nothing can close the tag.
const ld = JSON.stringify([
  { '@context': 'https://schema.org', '@type': 'MusicGroup', name: 'GLucak', url: `${SITE_URL}/`, logo: `${SITE_URL}/media/apple-touch-icon-180.png`, image: `${SITE_URL}/media/og/home.png`,
    genre: ['EDM', 'Hip-Hop/Rap', 'Rock'], sameAs: SOCIALS.map((s) => s.href) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'GLucak', url: `${SITE_URL}/` },
]).replace(/</g, '\\u003c');

const HERO = 'ab'; // D34: A (GLUCAK over the photo) under 900px, B (photo in the name, riso) from 900px up; 'a' / 'b' still work
---
<Base title="GLucak" home hero={HERO} credits={[C.kealey, C.joseph, C.yt, C.identity, ...(HERO === 'b' ? [C.mccc] : [])]}>
  <script type="application/ld+json" slot="head" set:html={ld}></script>
  <div class="top">
    <div class="glow" aria-hidden="true"></div>
    <Hero variant={HERO} />
    <RiseBand />
  </div>

  <section class="band band-live" id="shows" aria-labelledby="h-live">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine fade" id="h-live"><span class="tab">Shows</span> <span class="phrase fit"><span class="ln ln-live">Live It Loud</span></span></h2>
        <img class="v2-photo v2-wide-only v2-tall" src="/media/v2/stage-360.webp" srcset="/media/v2/stage-360.webp 360w, /media/v2/stage-634.webp 634w" sizes="40vw" width="634" height="1128" alt="GLucak singing on stage at Crooked Eye Brewery" loading="lazy" />
      </div>
      <div class="v2-main">
        <div id="shows-mount"><Fragment set:html="<!--gl:shows-->" /></div>
        <Quote band="live" class="quote-live" />
        <VideoBlock />
      </div>
    </div>
  </section>

  <section class="band band-push v2-push" id="about" aria-labelledby="h-push">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine fade" id="h-push"><span class="tab">About</span> <span class="phrase fit lock-push"><span class="ln ln-push1">Push Past</span> <span class="ln ln-push2">Fear</span></span></h2>
      </div>
      <div class="v2-main v2-push-body">
        <img class="v2-photo v2-belt" src="/media/v2/belt-320.webp" srcset="/media/v2/belt-320.webp 320w, /media/v2/belt-634.webp 634w" sizes="(min-width: 900px) 40vw, 30vw" width="634" height="1128" alt="GLucak live at Crooked Eye Brewery, arm raised" loading="lazy" />
        <div class="v2-slot v2-wide-only" role="img" aria-label="Empty photo slot: crowd shot, waiting on Gabe's OK"><span>Photo slot: crowd shot. Waiting on Gabe's OK.</span></div>
        <p class="bio-lead v2-bio">Despite facing various difficulties and struggles over the years, Epilepsy survivor and Producer-Rapper/DJ GLucak has shown no intent to give up on either his Faith in God or his mission in creating energetic music to bring others to Christ.</p>
        <div class="push-actions">
          <a class="btn btn-solid" href={PATREON} rel="noopener">Patreon</a>
          <a class="btn btn-line" href="/about/">Full bio</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-now" id="join" aria-labelledby="h-now">
    <div class="wrap v2-split">
      <div class="v2-side">
        <h2 class="spine fade" id="h-now"><span class="tab">Join</span> <span class="phrase fit"><span class="ln ln-now1">The Time</span> <span class="ln ln-now2">Is Now</span></span></h2>
      </div>
      <div class="v2-main now-grid">
        <Signup />
        <div class="v2-identity">
          <img class="v2-photo" src="/media/v2/identity-art-240.webp" srcset="/media/v2/identity-art-240.webp 240w, /media/v2/identity-art-480.webp 480w" sizes="(min-width: 900px) 12rem, 26vw" width="480" height="597" alt="IDENTITY artwork: GLucak in blue light" loading="lazy" />
          <div class="identity-state">
            {era.mark && <img class="mark mark-identity" src={era.mark} alt="" width="300" height="96" loading="lazy" />}
            <p class="identity">IDENTITY</p>
            {idn.date && (idn.out
              ? <p class="identity-when">Out now. <a class="text-link" href={idn.link} rel="noopener" aria-label="Listen to IDENTITY">Listen</a></p>
              : <><p class="identity-when identity-count"><time class="identity-date" datetime={idn.date}>{idn.pretty}</time>{' '}<span>{idn.days} {idn.days === 1 ? 'day' : 'days'} to go</span></p>
                 <a class="btn btn-line" href={idn.link} rel="noopener" aria-label="Pre-save IDENTITY">Pre-save</a></>)}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
