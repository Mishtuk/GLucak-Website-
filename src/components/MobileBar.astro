---
// Always visible under 700px, never hides on scroll (D8). Shop replaces Watch when the shop opens: server.js swaps the
// part between the gl:watch markers when SHOP_ENABLED=1 (src/lib/products.js shopLinks).
interface Props { home?: boolean; current?: string }
const { home = false, current } = Astro.props;
const items = [
  ['music', 'Listen', home ? '#music' : '/music/', '<path d="M9 18V6l10-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/>'],
  ['shows', 'Shows', home ? '#shows' : '/shows/', '<path d="M4 8V5h16v3a3 3 0 0 0 0 6v5H4v-5a3 3 0 0 0 0-6Z"/><path d="M14 5v2m0 3v2m0 3v4"/>'],
  ['videos', 'Watch', '/videos/', '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m10 9 5 3-5 3Z"/>'],
  ['join', 'Join', '#join', '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 7 9-7"/>'],
];
---
<nav class="phone-bar" aria-label="Quick actions">
  {items.map(([k, label, href, icon]) => (
    <>
      {k === 'videos' && <Fragment set:html="<!--gl:watch-->" />}
      <a href={href} aria-current={current === k ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} /><span>{label}</span>
      </a>
      {k === 'videos' && <Fragment set:html="<!--/gl:watch-->" />}
    </>
  ))}
</nav>
