---
import Quote from './Quote.astro';
import { PLATFORMS, SPOTIFY_EMBED, SPOTIFY_PLAYLIST } from './content.js';
import rows from '../data/releases.json';
import { latestHtml, listenHtml } from '../lib/releases.js';
// Home (release): one panel with the cover, title, Listen and the player; a garage still beside it from 900px (v2 port).
// The player is first in the DOM (phones: first on screen, and Tab reaches it before Listen); player first at every width (DESIGN 28h).
// release={false} on /music/: the player alone (the crate's first released tile is that release); Rise is its h1 (release title drops to h2).
const { h1 = false, release = true, ground = false } = Astro.props;
const H = h1 ? 'h1' : 'h2'; // the release title below is an h3 (src/lib/releases.js); on /music/ (h1) there is no release block
---
<section class:list={['band band-rise', ground && 'has-ground ground-grooves']} id="music" aria-labelledby="h-rise">
  <div class="wrap v2-split">
    <div class="v2-side">
      <H class="spine" id="h-rise"><span class="tab">Music</span> <span class="phrase phrase-rise">Rise</span></H>
      {release && <img class="v2-photo v2-wide-only v2-land print" src="/media/v2/garage-toner-480.webp" srcset="/media/v2/garage-toner-480.webp 480w, /media/v2/garage-toner-874.webp 640w" sizes="40vw" width="640" height="360" alt="GLucak in a tire shop garage, from the Duck, Dodge, Jump, Fight video" loading="lazy" />}
    </div>
    <div class:list={[release && 'v2-card']}>
      <div class={release ? 'rise-play' : 'rise-player'}>
        <a class="skip skip-inline" href="#after-player">Skip the Spotify player</a>
        <div class="player-box">
          <p class="player-note">Player not loading? Play it on Spotify below.</p>
          <iframe class="player" title="GLucak playlist on Spotify" src={SPOTIFY_EMBED} width="100%" height="352" loading="lazy" allow="encrypted-media; clipboard-write; fullscreen"></iframe>
        </div>
        <p class="under-player" id="after-player">
          <a class="btn btn-line btn-small" href={SPOTIFY_PLAYLIST} rel="noopener">Play full songs on Spotify</a>
          {PLATFORMS.map((p) => <a class="under-link" href={p.href} rel="noopener">{p.name}</a>)}
          {!release && <Fragment set:html={listenHtml(rows)} />}
        </p>
      </div>
      {release && <Fragment set:html={latestHtml(rows)} />}
      {release && <Quote band="rise" />}
    </div>
  </div>
</section>
