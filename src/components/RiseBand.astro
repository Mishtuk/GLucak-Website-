---
import Quote from './Quote.astro';
import NoCover from './NoCover.astro';
import { credit, dateLine, releases, SPOTIFY_EMBED, SPOTIFY_PLAYLIST } from './content.js';
// Home (release): one panel with the cover, title, Listen and the player; a garage still beside it from 900px (v2 port).
// The player is first in the DOM (phones: first on screen, and Tab reaches it before Listen); from 900px CSS order puts the cover row first.
// release={false} on /music/: the player alone (the crate's first released tile is that release); Rise is its h1 (release title drops to h2).
const { h1 = false, release = true } = Astro.props;
const H = h1 ? 'h1' : 'h2', T = h1 ? 'h2' : 'h3';
const r = releases()[0];
---
<section class="band band-rise" id="music" aria-labelledby="h-rise">
  <div class="wrap v2-split">
    <div class="v2-side">
      <H class="spine" id="h-rise"><span class="tab">Music</span> <span class="phrase phrase-rise">Rise</span></H>
      {release && <img class="v2-photo v2-wide-only v2-land" src="/media/v2/garage-toner-480.webp" srcset="/media/v2/garage-toner-480.webp 480w, /media/v2/garage-toner-874.webp 640w" sizes="40vw" width="640" height="360" alt="GLucak in a tire shop garage, from the Duck, Dodge, Jump, Fight video" loading="lazy" />}
    </div>
    <div class:list={[release && 'v2-card']}>
      <div class={release ? 'rise-play' : 'rise-player'}>
        <a class="skip skip-inline" href="#after-player">Skip the Spotify player</a>
        <div class="player-box">
          <p class="player-note">Loading the Spotify player. Not showing? Use <strong>Play full songs on Spotify</strong> below.</p>
          <iframe class="player" title="GLucak playlist on Spotify" src={SPOTIFY_EMBED} width="100%" height="352" loading="lazy" allow="encrypted-media; clipboard-write; fullscreen"></iframe>
        </div>
        <p class="under-player" id="after-player">
          <a class="btn btn-line btn-small" href={SPOTIFY_PLAYLIST} rel="noopener">Play full songs on Spotify</a>
          {release
            ? r.soundcloud && <a class="under-link" href={r.soundcloud} rel="noopener">SoundCloud</a>
            : <a class="under-link" href={r.link} rel="noopener" aria-label={`Listen everywhere: ${r.title}`}>Listen everywhere</a>}
        </p>
      </div>
      {release && <article class="v2-rel">
        {r.placeholder
          ? <NoCover class="v2-cover" title={r.title} type={r.type} label={`${r.title}: no cover art yet`} />
          : <img class="v2-cover" src={r.cover} alt={`${r.title} cover art`} width="400" height="400" />}
        <div class="v2-rel-text">
          <p class="v2-kicker"><span class="v2-kicker-type">Latest {r.type ?? 'release'}</span>{r.date && <>{' '}<span>{dateLine(r.date).replaceAll(" ", " ")}</span></>}</p>
          <T>{r.title}</T>
          {credit(r) && <p class="credit">{credit(r)}</p>}
          <a class="btn btn-solid" href={r.link} rel="noopener" aria-label={`Listen to ${r.title}`}>Listen</a>
        </div>
      </article>}
      {release && <Quote band="rise" />}
    </div>
  </div>
</section>
