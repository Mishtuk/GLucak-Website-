---
import Signup from './Signup.astro';
import { SOCIALS } from './content.js';
interface Props { home?: boolean }
const { home = false } = Astro.props;
---
<footer class="site-footer" id="footer">
  <div class="wrap">
    {!home && <div class="footer-join" id="join"><Signup /></div>}
    <p class="closing fit"><span class="ln ln-close"><a href={home ? '#music' : '/music/'}>Listen.</a> <a href={home ? '#shows' : '/shows/'}>Shows.</a> <a href="#join">Join.</a></span></p>
    <ul class="socials">
      {SOCIALS.map(([name, href]) => <li><a href={href} rel="noopener">{name}</a></li>)}
    </ul>
    <p class="footer-slogan">Rise, Live It Loud, Push Past Fear, The Time Is Now.</p>
    <div class="footer-row">
      <button class="motion-btn" id="motion" type="button" aria-pressed="true">Motion: on</button>
      <p class="legal">&copy; <span id="year">{new Date().getFullYear()}</span> GLucak. <a href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>
