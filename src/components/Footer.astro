---
import Signup from './Signup.astro';
import { SOCIALS, era } from './content.js';
import palettes from '../palettes.json';
interface Props { home?: boolean; credits?: string[]; signup?: boolean }
const { home = false, credits = [], signup = true } = Astro.props;
const join = home || signup ? '#join' : '/#join';
---
<footer class="site-footer edge-tear" id="footer">
  {era.name === 'Placeholder' && <p class="ph-chip footer-chip">Placeholder colors</p>}
  <div class="wrap">
    {!home && signup && <div class="footer-join" id="join"><Signup /></div>}
    <p class="closing fit"><span class="ln ln-close"><a href={home ? '#music' : '/music/'} aria-label="Listen to the music">Listen</a> <a href={home ? '#shows' : '/shows/'} aria-label="See the shows">Shows</a><Fragment set:html="<!--gl:footer-shop-->" /> <a href={join} aria-label="Join the email list">Join</a></span></p>
    <ul class="links">
      {SOCIALS.map((s) => <li class={s.id === 'patreon' ? 'links-wide' : undefined}><a href={s.href} rel="noopener"><svg aria-hidden="true"><use href={`#i-${s.id}`} /></svg><span>{s.name}</span></a></li>)}
    </ul>
    <p class="footer-slogan">Rise, Live It Loud, Push Past Fear, The Time Is Now.</p>
    {credits.length > 0 && <p class="credits">Credits: Alexander Kealey, Joseph Lucak, GLucak, Dave Bahm</p>}
    <div class="footer-row">
      <button class="motion-btn" id="motion" type="button" aria-pressed="true">Motion: on</button>
      <p class="legal">&copy; <span id="year">{new Date().getFullYear()}</span> GLucak. <a href="/privacy/">Privacy</a>. Site by Mishtuk Web Design.</p>
      {/* DESIGN 30d: the owner's colour preview. Hidden; app.js shows it only on ?palettes or once a palette is stored. */}
      <details class="pal" id="pal" hidden>
        <summary>Colors</summary>
        <div class="pal-sheet" role="group" aria-label="Color palettes">
          {palettes.map((p) => (
            <button type="button" class="pal-opt" data-pal={p.id} aria-pressed="false" style={`--s1:${p.colors.bg};--s2:${p.colors.text};--s3:${p.colors.accent}`}><span class="pal-sw" aria-hidden="true"></span><span class="pal-name">{p.name}</span> <span class="pal-mood">{p.mood}</span></button>
          ))}
          <button type="button" class="pal-reset">Reset to IDENTITY</button>
        </div>
      </details>
    </div>
  </div>
</footer>
