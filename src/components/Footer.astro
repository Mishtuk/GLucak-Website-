---
import Signup from './Signup.astro';
import { SOCIALS, era } from './content.js';
interface Props { home?: boolean; credits?: string[] }
const { home = false, credits = [] } = Astro.props;
---
<footer class="site-footer" id="footer">
  {era.name === 'Placeholder' && <p class="ph-chip footer-chip">Placeholder colors</p>}
  <div class="wrap">
    {!home && <div class="footer-join" id="join"><Signup /></div>}
    <p class="closing fit"><span class="ln ln-close"><a href={home ? '#music' : '/music/'} aria-label="Listen to the music">Listen.</a> <a href={home ? '#shows' : '/shows/'} aria-label="See the shows">Shows.</a><Fragment set:html="<!--gl:footer-shop-->" /> <a href="#join" aria-label="Join the email list">Join.</a></span></p>
    <ul class="links">
      {SOCIALS.map((s) => <li class={s.id === 'patreon' ? 'links-wide' : undefined}><a href={s.href} rel="noopener"><svg aria-hidden="true"><use href={`#i-${s.id}`} /></svg><span>{s.name}</span></a></li>)}
    </ul>
    <p class="footer-slogan">Rise, Live It Loud, Push Past Fear, The Time Is Now.</p>
    {credits.length > 0 && <p class="credits">{credits.join(' ')}</p>}
    <div class="footer-row">
      <button class="motion-btn" id="motion" type="button" aria-pressed="true">Motion: on</button>
      <p class="legal">&copy; <span id="year">{new Date().getFullYear()}</span> GLucak. <a href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>
