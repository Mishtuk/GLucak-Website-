---
import { BOOKING_EMAIL, bookingHref } from '../lib/shows.js';
const { photo = false } = Astro.props; // DESIGN 25f: Shows only
// DESIGN 24b / 28d: the booker's block. Request a show goes to the Instagram profile until BOOKING_EMAIL is set.
---
<div class="venues">
  {photo && <img class="venues-photo" src="/media/cd-live-640.webp" srcset="/media/cd-live-640.webp 640w, /media/cd-live-1280.webp 1280w" sizes="(min-width: 72rem) 34rem, 100vw" width="1280" height="640" alt="GLucak singing live in purple light" loading="lazy" />}
  <h2>Book GLucak</h2>
  <p class="venues-line">Horsham-based producer-rapper and DJ. Open mics and full shows, often with guitarist Fran Carroll.</p>
  <p class="venues-act">
    <a class="btn btn-line" href={bookingHref()} aria-label={BOOKING_EMAIL ? 'Request a show by email' : 'Request a show on Instagram'}>Request a show</a>
  </p>
  {!BOOKING_EMAIL && <p class="venues-hint">Opens Instagram. Press Message to ask about a date.</p>}
  {BOOKING_EMAIL && <p class="venues-addr">{BOOKING_EMAIL}</p>}
</div>
