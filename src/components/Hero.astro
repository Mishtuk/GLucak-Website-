---
import { releases } from './content.js';
// Hero A (default) or B (D14): one prop. A = GLUCAK over a full-bleed duotone photo; B = photo set into the name.
interface Props { variant?: 'a' | 'b' }
const { variant = 'a' } = Astro.props;
const now = releases()[0];
const W = 2400, H = 1600;
---
<section class="hero" aria-label="GLucak">
  {variant === 'a' && (
    <div class="hero-photo">
      <picture>
        <source type="image/webp" srcset="/media/live-1200.webp 1200w, /media/live-2400.webp 2400w" sizes="100vw" />
        <img class="duo" src="/media/live-1200.jpg" srcset="/media/live-1200.jpg 1200w, /media/live-2400.jpg 2400w" sizes="100vw" alt="" width={W} height={H} fetchpriority="high" />
      </picture>
    </div>
  )}
  <div class="wrap hero-inner">
    <h1 class="name" aria-label="GLucak">
      <span class="name-row" aria-hidden="true"><span class="n-g">G</span>{variant === 'b' && (
        <span class="slot"><picture><source type="image/webp" srcset="/media/live-1200.webp" /><img class="duo" src="/media/live-1200.jpg" alt="" width={W} height={H} fetchpriority="high" /></picture></span>
      )}<span class="n-rest">LUCAK</span></span>
    </h1>
    <p class="slogan fit"><span class="sl sl-1">Rise, Live It Loud,</span> <span class="sl sl-2">Push Past Fear, The Time Is Now.</span></p>
    <div class="hero-actions">
      <a class="btn btn-solid" href="#music">Listen</a>
      <a class="btn btn-line" href="#shows">Shows</a>
    </div>
    <p class="now"><span class="now-tag">Now</span> <a href={now.link} rel="noopener">{now.title} is out. Listen everywhere</a></p>
  </div>
  <p class="ph-chip hero-chip">Placeholder colors</p>
</section>
