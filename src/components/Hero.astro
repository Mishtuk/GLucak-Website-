---
import { releases } from './content.js';
// D34 hero, DESIGN 29: A under 900px (GLUCAK over his print), from 900px GLUCAK whole across the top with his print taped beside the slogan (DESIGN 30e). Both are Print, one ink.
// Each <picture> serves a 1x1 data GIF at the width where it's hidden, so only one photo downloads.
const GIF = 'data:image/gif;base64,R0lGODlhAQABAAAAACw=';
const now = releases()[0];
const TYPE: Record<string, string> = { single: 'Single', ep: 'EP', album: 'Album', remix: 'Remix album' };
---
<section class="hero" aria-label="GLucak">
  <div class="hero-wall" aria-hidden="true"></div>
  <div class="hero-photo">
    <picture>
      <source media="(min-width: 900px)" srcset={GIF} />
      <img class="graded print" src="/media/a-print-phone-800.webp" alt="" width="800" height="1000" fetchpriority="high" />
    </picture>
  </div>
  {/* Owner 2026-11-18: the hero is Gabe's music videos (.work/mv/build.mjs: calm shots only, flash-checked, slowed, gray). app.js plays it
       only while Motion is on; until then (and with Motion off) the still hero above shows. Two inks come from CSS. */}
  <div class="hero-film" aria-hidden="true">
    <video muted loop playsinline preload="none" disablepictureinpicture disableremoteplayback>
      <source media="(max-width: 699px) and (orientation: portrait)" src="/media/film/hero-port.mp4" type="video/mp4" />
      <source src="/media/film/hero-land.mp4" type="video/mp4" />
    </video>
  </div>
  <button class="film-btn" type="button" hidden>Pause video</button>
  <div class="wrap hero-inner">
    <h1 class="name" aria-label="GLucak">
      <span class="name-row" aria-hidden="true"><span class="n-g">G</span><span class="n-rest">LUCAK</span></span>
    </h1>
    <p class="slogan fit"><span class="sl sl-1">Rise, Live It Loud,</span> <span class="sl sl-2">Push Past Fear, The Time Is Now.</span></p>
    <div class="hero-actions">
      <a class="btn btn-solid" href="#music" aria-label="Listen to the music">Listen</a>
      <a class="go" href="#shows" aria-label="See upcoming shows">Shows</a>
    </div>
    <p class="now"><Fragment set:html="<!--gl:now-->" /><a class="stub" href={now.link} rel="noopener"><span class="stub-when">Out now</span> <span class="stub-what"><span class="stub-place">{now.title}</span>{TYPE[now.type] && <Fragment> <span class="stub-sub">{TYPE[now.type]}</span></Fragment>}</span></a><Fragment set:html="<!--/gl:now-->" /></p>
    <p class="sound">EDM, rap and rock. Raw lyrics, real faith, high energy.</p>
    <figure class="hero-print taped" aria-hidden="true"><picture><source media="(min-width: 900px)" srcset="/media/b-print-600.webp 600w, /media/b-print-1000.webp 1000w" sizes="33vw" /><img class="graded print" src={GIF} alt="" width="1000" height="706" /></picture></figure>
  </div>
</section>
