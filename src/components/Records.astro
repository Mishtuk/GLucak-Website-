---
import { existsSync } from 'node:fs';
import { videosPage, SHORTS } from './content.js';
import { curly } from '../lib/shows.js';
// Owner 2026-11-18: the records cover flow on Home and Videos. Every video is a record: a designed sleeve (a real still) with the vinyl
// peeking out; pressing one opens it in the dialog (app.js). No iframe until a press (hard rule 1). `more`: on Home, an "All videos" link.
// `compact` (/shows/, owner 2026-11-18): the first 3 as a plain still row under a "Watch" heading; no pin, no cover-flow tilt.
const { more = false, compact = false } = Astro.props;
const g = videosPage();
const every = [...g.music, ...(g.lead ? [g.lead, ...g.live] : g.live)];
const all = compact ? every.slice(0, 3) : every;
const pic = (id: string, dir: string, big: number) => existsSync(`public/media/${dir}/${id}-${big}.webp`) ? `/media/${dir}/${id}` : null;
const meta = (v: Record<string, any>) => [v.place ? `Live at ${v.place}` : v.kind === 'lyric-video' ? 'Lyric video' : 'Music video', v.with].filter(Boolean).join(more || compact ? ', ' : ' · '); // Home prints no middle dot (test 20d)
const name = (v: Record<string, any>) => curly(v.name ?? v.title);
const pad = (n: number) => String(n).padStart(2, '0');
const W = compact ? 'div' : 'section';
const Wrap = compact ? Fragment : 'div';
---
{all.length > 0 && (
  <W class={compact ? 'records-watch' : 'band band-crate'} id={compact ? 'shows-video' : undefined} data-hs={compact ? undefined : 'row'} aria-labelledby={compact ? undefined : 'h-crate'}>
    <Wrap {...(compact ? {} : { class: 'wrap' })}>
      {compact
        ? <h2><a class="h-go" href="/videos/">Watch<span class="vh"> all videos</span></a></h2>
        : <h2 class="crate-h" id="h-crate">{more ? <a class="h-go" href="/videos/">Records<span class="vh"> all videos</span></a> : 'Records'}</h2>}
      {!compact && <p class="crate-sub">Every music video and live clip. Scroll to flip through, then press a record to open it.</p>}
      <ul class={compact ? 'records records-static' : 'records'}>
        {all.map((v, i) => {
          const art = pic(v.id, 'sleeves', 640);
          return (
            <li class={`rec rec-${'abcd'[i % 4]}`}>
              <a class="rec-link" href={`https://www.youtube.com/watch?v=${v.id}`} rel="noopener" data-yt={v.id} data-title={name(v)} data-meta={meta(v)}>
                <span class="rec-disc" aria-hidden="true"><span class="rec-label">{pad(i + 1)}</span></span>
                <span class="rec-sleeve" aria-hidden="true">
                  {art && <img class="rec-img" src={`${art}-320.webp`} srcset={`${art}-320.webp 320w, ${art}-640.webp 640w`} sizes="(min-width: 900px) 22vw, 42vw" width="640" height="640" alt="" loading="lazy" decoding="async" />}
                  <span class="rec-type"><span class="rec-artist">GLucak</span><span class="rec-name"><span>{name(v)}</span></span><span class="rec-no"><span class="rec-no-l">No. </span>{pad(i + 1)}</span></span>
                </span>
                <span class="rec-cap"><span class="v2-vtitle">{name(v)}</span><span class="vid-meta">{meta(v)}</span></span>
              </a>
            </li>
          );
        })}
      </ul>
      {!compact && <p class="start-line vid-more">{more ? <a class="go" href="/videos/">All videos</a> : <a class="go" href={SHORTS} rel="noopener">New shorts most weeks on YouTube.</a>}</p>}
    </Wrap>
  </W>
)}
<dialog class="rec-open" id="rec-open" aria-labelledby="ro-title">
  <div class="ro-in">
    <div class="ro-head">
      <div><h2 id="ro-title"></h2><p class="vid-meta ro-meta"></p></div>
      <button type="button" class="ro-close">Close</button>
    </div>
    <div class="ro-stage"><span class="ro-disc" aria-hidden="true"></span><div class="ro-screen"></div></div>
  </div>
</dialog>
