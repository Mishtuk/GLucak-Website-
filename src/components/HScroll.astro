---
// Owner 2026-11-18: "more seamless looking through the page", no arrow bar. A pinned horizontal gallery (the Awwwards pattern): with
// Motion on (app.js adds .is-pinned) the strip sticks and scrolling down slides it sideways, coupled to the scroll, nothing on its
// own. Motion off, reduced motion or no JS: a plain swipe row. Paper prints, a scrapbook ({ src, w, h, srcset?, alt, cap }).
interface Props { id: string; title: string; sub?: string; kind: 'photo'; items: Record<string, any>[]; tail?: { href: string; text: string } }
const { id, title, sub, kind, items, tail } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class:list={['hs', `hs-${kind}`]} data-hs id={id} aria-labelledby={`h-${id}`}>
  <div class="hs-pin">
    <ol class="hs-track">
      <li class="hs-head"><h2 class="hs-title" id={`h-${id}`}>{title}</h2>{sub && <p class="hs-sub">{sub}</p>}</li>
      {items.map((it, i) => (
        <li class="hs-item">
          <figure class="hs-print is-paper">
            <img src={it.src} srcset={it.srcset} sizes="(min-width: 700px) 40vw, 80vw" width={it.w} height={it.h} alt={it.alt} loading="lazy" decoding="async" />
            <figcaption><span class="hs-n" aria-hidden="true">{pad(i + 1)}</span> {it.cap}</figcaption>
          </figure>
        </li>
      ))}
      {tail && <li class="hs-tail"><a class="go" href={tail.href} rel="noopener">{tail.text}</a></li>}
    </ol>
  </div>
</section>
