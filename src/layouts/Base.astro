---
import '../styles/global.css';
import Header from '../components/Header.astro';
import MobileBar from '../components/MobileBar.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import { era, SITE_URL } from '../components/content.js';

interface Props { title: string; description?: string; home?: boolean; hero?: 'a' | 'b'; current?: 'music' | 'shows' | 'about'; credits?: string[]; image?: string }
const { title, description = 'GLucak: Rise, Live It Loud, Push Past Fear, The Time Is Now.', home = false, hero = 'a', current, credits, image = 'home' } = Astro.props;
const ogImage = `${SITE_URL}/media/og/${image}.png`;

// Era colors become custom properties (D12). Only #rrggbb values pass.
const HEX = /^#[0-9a-f]{6}$/i;
const eraCss = Object.entries(era.colors).filter(([, v]) => HEX.test(v)).map(([k, v]) => `--${k}:${v}`).join(';') +
  (era.texture ? `;--texture:url('${encodeURI(era.texture)}')` : '');

// Duotone: bg in the shadows, capped accent at the peak (DESIGN.md section 3). The peak is the first mix of bg toward
// accent that still has 4:1 against text, so text over any tinted photo passes 3:1 in any era.
const rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
const lin = (c) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const lum = ([r, g, b]) => 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
const ratio = (a, b) => (Math.max(lum(a), lum(b)) + 0.05) / (Math.min(lum(a), lum(b)) + 0.05);
function peak(bg, accent, text) {
  for (let t = 1; t > 0; t -= 0.01) {
    const c = bg.map((b, i) => b + (accent[i] - b) * t);
    if (ratio(text, c) >= 4) return c;
  }
  return bg;
}
const lo = rgb(era.colors.bg);
const hi = peak(lo, rgb(era.colors.accent), rgb(era.colors.text));
const table = (i) => `${lo[i].toFixed(3)} ${hi[i].toFixed(3)}`;
---
<!doctype html>
<html lang="en" data-hero={hero} data-home={home ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={era.colors.bg} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={`${SITE_URL}${Astro.url.pathname}`} />
    <link rel="icon" href="/media/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/media/apple-touch-icon-180.png" />
    <link rel="preload" href="/fonts/big-shoulders-display-900.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/atkinson-hyperlegible-next-wght.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style set:html={`:root{${eraCss}}`}></style>
    <script is:inline src="/js/boot.js"></script>
    <script is:inline src="/js/app.js" defer></script>
  </head>
  <body>
    <Icons />
    <a class="skip" href="#main">Skip to content</a>

    <!-- Duotone for live photos only. The tables come from the era colors at build. Covers never use this. -->
    <svg class="defs" aria-hidden="true" width="0" height="0">
      <filter id="duo" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="0.30 0.59 0.11 0 0  0.30 0.59 0.11 0 0  0.30 0.59 0.11 0 0  0 0 0 1 0" />
        <feComponentTransfer>
          <feFuncR type="table" tableValues={table(0)} />
          <feFuncG type="table" tableValues={table(1)} />
          <feFuncB type="table" tableValues={table(2)} />
        </feComponentTransfer>
      </filter>
    </svg>

    <Header home={home} current={current} />
    <main id="main" class={home ? undefined : 'sub'}>
      <slot />
    </main>
    <Footer home={home} credits={credits} />
    <MobileBar home={home} current={current} />
  </body>
</html>
