---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main">
        <a href="/">Home</a> <a href="/music/">Music</a> <a href="/shows/">Shows</a> <a href="/about/">About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer><a href="/privacy/">Privacy</a></footer>
  </body>
</html>
<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; }
</style>
